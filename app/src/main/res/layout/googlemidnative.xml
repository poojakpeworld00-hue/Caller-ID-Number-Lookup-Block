<?xml version="1.0" encoding="utf-8"?>
<!-- Mid native, no media (Claude Design "Ads Redesign" · small native): 54dp r16 icon, headline +
     Ad badge, star rating, body, full-width green Install button that glows (NativeAdLook). -->
<com.google.android.gms.ads.nativead.NativeAdView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainNativeadView"
    style="@style/AdCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/ad_card_margin_h"
    android:layout_marginEnd="@dimen/ad_card_margin_h"
    android:layout_marginTop="@dimen/ad_card_margin_top"
    android:layout_marginBottom="@dimen/ad_card_margin_bottom"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ad_app_icon"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:adjustViewBounds="true"
                android:background="@color/ad_sk"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/AdIconR16" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                    <TextView
                    android:id="@+id/ad_headline"
                    style="@style/AdHeadline"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                        android:textSize="15sp"
                        tools:text="FitTrack — Workout Planner"
                    app:layout_constrainedWidth="true"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/ad_badge"
                    app:layout_constraintHorizontal_bias="0"
                    app:layout_constraintHorizontal_chainStyle="packed"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintWidth_default="wrap" />

                    <TextView
                    android:id="@+id/ad_badge"
                    style="@style/AdTag"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/ad_headline"
                    app:layout_constraintTop_toTopOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <TextView
                    android:id="@+id/ad_stars"
                    style="@style/AdStars"
                    android:layout_marginTop="4dp"
                    tools:text="★★★★★ 4.6"
                    tools:visibility="visible" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/ad_body"
            style="@style/AdBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lineSpacingMultiplier="1.2"
            android:textSize="12.5sp"
            tools:text="Plan workouts, track progress and hit your goals in 10 minutes a day." />

        <TextView
            android:id="@+id/ad_call_to_action"
            style="@style/AdCta"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_ad_cta_green"
            android:elevation="4dp"
            android:outlineAmbientShadowColor="@color/ad_green"
            android:outlineSpotShadowColor="@color/ad_green"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:tag="glow"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            tools:targetApi="p"
            tools:text="Install" />
    </LinearLayout>
</com.google.android.gms.ads.nativead.NativeAdView>
