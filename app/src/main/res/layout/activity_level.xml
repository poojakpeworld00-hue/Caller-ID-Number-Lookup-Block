<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/levelRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background"
        tools:context=".ui.tools.TiltActivity">

        <!-- Top bar -->
        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/_8sdp"
            android:paddingVertical="@dimen/_6sdp"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="@dimen/_40sdp"
                android:layout_height="@dimen/_40sdp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/onboarding_skip"
                android:padding="@dimen/_8sdp"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/on_surface" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_4sdp"
                android:text="@string/tools_level"
                android:textColor="@color/on_surface"
                android:textSize="@dimen/_14ssp"
                android:textStyle="bold" />
        </LinearLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:fillViewport="true"
            app:layout_constraintBottom_toTopOf="@id/bannerAdFrame"
            app:layout_constraintTop_toBottomOf="@id/topBar">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layoutAnimation="@anim/tool_layout_in"
                android:orientation="vertical">
                <FrameLayout
                    android:id="@+id/adNativeFrame"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/_12sdp"
                    android:layout_marginVertical="@dimen/_10sdp">

                    <com.facebook.shimmer.ShimmerFrameLayout
                        android:id="@+id/adShimmer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#ccc">

                        <include layout="@layout/googlemidnative2" />
                    </com.facebook.shimmer.ShimmerFrameLayout>
                </FrameLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/_16sdp"
                    android:paddingBottom="@dimen/_16sdp"
                    app:layout_constraintBottom_toTopOf="@id/bannerAdFrame"
                    app:layout_constraintTop_toBottomOf="@id/topBar">

                    <!-- Tilt readout -->
                    <TextView
                        android:id="@+id/tvTilt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="@dimen/_6sdp"
                        android:textColor="@color/on_surface"
                        android:textSize="@dimen/_22ssp"
                        android:textStyle="bold"
                        tools:text="3.2°" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="@dimen/_2sdp"
                        android:letterSpacing="0.1"
                        android:text="@string/level_current_tilt"
                        android:textAllCaps="true"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="@dimen/_10ssp"
                        android:textStyle="bold" />

                    <!-- Level dial (centered in remaining space) -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1">

                        <FrameLayout
                            android:id="@+id/dialArea"
                            android:layout_width="@dimen/_200sdp"
                            android:layout_height="@dimen/_200sdp"
                            android:layout_gravity="center">

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/bg_compass_dial" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/_1sdp"
                                android:layout_gravity="center_vertical"
                                android:alpha="0.5"
                                android:background="@color/outline" />

                            <View
                                android:layout_width="@dimen/_1sdp"
                                android:layout_height="match_parent"
                                android:layout_gravity="center_horizontal"
                                android:alpha="0.5"
                                android:background="@color/outline" />

                            <View
                                android:layout_width="@dimen/_175sdp"
                                android:layout_height="@dimen/_175sdp"
                                android:layout_gravity="center"
                                android:background="@drawable/bg_ring" />

                            <View
                                android:layout_width="@dimen/_50sdp"
                                android:layout_height="@dimen/_50sdp"
                                android:layout_gravity="center"
                                android:background="@drawable/bg_ring" />

                            <View
                                android:id="@+id/bubble"
                                android:layout_width="@dimen/_38sdp"
                                android:layout_height="@dimen/_38sdp"
                                android:layout_gravity="center"
                                android:background="@drawable/bg_level_bubble" />
                        </FrameLayout>
                    </FrameLayout>

                    <!-- Dual-axis data card -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_card_border"
                        android:orientation="vertical"
                        android:padding="@dimen/_14sdp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:letterSpacing="0.04"
                                android:text="@string/level_dual_axis"
                                android:textAllCaps="true"
                                android:textColor="@color/on_surface"
                                android:textSize="@dimen/_11ssp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_pill"
                                android:backgroundTint="@color/primary_container"
                                android:paddingHorizontal="@dimen/_9sdp"
                                android:paddingVertical="@dimen/_3sdp"
                                android:text="@string/level_adjusting"
                                android:textAllCaps="true"
                                android:textColor="@color/primary"
                                android:textSize="@dimen/_8ssp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_12sdp"
                            android:baselineAligned="false"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/level_x_axis"
                                    android:textColor="@color/on_surface_variant"
                                    android:textSize="@dimen/_9ssp" />

                                <TextView
                                    android:id="@+id/tvX"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/_2sdp"
                                    android:textColor="@color/primary"
                                    android:textSize="@dimen/_16ssp"
                                    android:textStyle="bold"
                                    tools:text="-2.7°" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/level_y_axis"
                                    android:textColor="@color/on_surface_variant"
                                    android:textSize="@dimen/_9ssp" />

                                <TextView
                                    android:id="@+id/tvY"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/_2sdp"
                                    android:textColor="@color/primary"
                                    android:textSize="@dimen/_16ssp"
                                    android:textStyle="bold"
                                    tools:text="1.7°" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/btnCalibrate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="@dimen/_12sdp"
                        android:background="@drawable/bg_search_pill"
                        android:gravity="center"
                        android:padding="@dimen/_12sdp"
                        android:text="@string/level_calibrate"
                        android:textAllCaps="true"
                        android:textColor="@color/white"
                        android:textSize="@dimen/_12ssp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/primary"
                        app:cornerRadius="@dimen/_14sdp"
                        app:icon="@drawable/ic_refresh"
                        app:iconGravity="textStart"
                        app:iconSize="@dimen/_18sdp"
                        app:iconTint="@color/white" />
                </LinearLayout>



            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Full-bleed hairline separating app content from the ad below -->
        <View
            android:id="@+id/adBannerDivider"
            style="@style/AdDivider"
            android:layout_width="0dp"
            app:layout_constraintBottom_toTopOf="@id/bannerAdFrame"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Bottom adaptive banner (auto-loaded by BaseActivity, type from ScreenAds config). -->
        <include
            layout="@layout/view_bottom_banner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
