<?xml version="1.0" encoding="utf-8"?>
<!-- Quick action — Claude Design "actions 3" cell: a per-action tinted icon
     circle (background/icon tint set per-instance in DashboardFragment.bindQuick)
     and a label beneath it. No per-tile card — the shared card is the parent
     row's own background in fragment_home.xml. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/qaIconCircle"
        android:layout_width="@dimen/_44sdp"
        android:layout_height="@dimen/_44sdp"
        android:background="@drawable/bg_qa_icon_circle">

        <ImageView
            android:id="@+id/qaIcon"
            android:layout_width="@dimen/_22sdp"
            android:layout_height="@dimen/_22sdp"
            android:layout_gravity="center"
            android:src="@drawable/ic_dialpad"
            tools:ignore="ContentDescription" />
    </FrameLayout>

    <!-- gap 9px, matches Claude Design's actions-3 cell -->
    <TextView
        android:id="@+id/qaLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_9sdp"
        android:fontFamily="@font/nunito_semibold"
        android:textColor="@color/on_surface"
        android:textSize="@dimen/_8ssp"
        tools:text="Dialer" />
</LinearLayout>
