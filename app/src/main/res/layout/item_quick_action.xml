<?xml version="1.0" encoding="utf-8"?>
<!-- Quick action: a white tile with a single primary-tinted icon and a label
     beneath it (Home v2 — one icon language). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/_46sdp"
        android:background="@drawable/bg_home_tile"
        android:elevation="@dimen/_1sdp"
        android:outlineAmbientShadowColor="@color/card_shadow"
        android:outlineSpotShadowColor="@color/card_shadow">

        <ImageView
            android:id="@+id/qaIcon"
            android:layout_width="@dimen/_19sdp"
            android:layout_height="@dimen/_19sdp"
            android:layout_gravity="center"
            android:src="@drawable/ic_dialpad"
            app:tint="@color/primary"
            tools:ignore="ContentDescription" />
    </FrameLayout>

    <TextView
        android:id="@+id/qaLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_5sdp"
        android:textColor="@color/on_surface_variant"
        android:textSize="@dimen/_8ssp"
        android:textStyle="bold"
        tools:text="Dialer" />
</LinearLayout>
