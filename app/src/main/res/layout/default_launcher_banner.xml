<?xml version="1.0" encoding="utf-8"?><!--
    Outer wrapper is transparent and takes the status bar inset padding; the bordered card lives
    inside it, same nesting the reference app uses.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:paddingHorizontal="10dp"
    android:paddingTop="12dp"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_default_launcher_banner"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_banner_warning" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <org.fossify.commons.views.MyTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/default_launcher_banner_title"
                android:textColor="#000000"
                android:textSize="15sp"
                android:textStyle="bold" />

            <org.fossify.commons.views.MyTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/default_launcher_banner_body"
                android:textColor="#767676"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
