<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/blocklistRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background"
        tools:context=".ui.blocklist.BlockRosterActivity">

        <!-- Top bar -->
        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/_8sdp"
            android:paddingVertical="@dimen/_8sdp"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="@dimen/_34sdp"
                android:layout_height="@dimen/_34sdp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/onboarding_skip"
                android:padding="@dimen/_5sdp"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/on_surface" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_2sdp"
                android:text="@string/blocklist_title"
                android:textColor="@color/on_surface"
                android:textSize="@dimen/_14ssp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ===== POPULATED ===== -->

        <!-- Slim summary strip (not a hero card celebrating a number) -->
        <LinearLayout
            android:id="@+id/summaryStrip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_18sdp"
            android:layout_marginTop="@dimen/_10sdp"
            android:background="@drawable/bg_row_neutral"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/_14sdp"
            android:paddingVertical="@dimen/_10sdp"
            app:layout_constraintTop_toBottomOf="@id/topBar">

            <ImageView
                android:layout_width="@dimen/_34sdp"
                android:layout_height="@dimen/_34sdp"
                android:background="@drawable/bg_summary_tile"
                android:contentDescription="@string/blocklist_section_blocked"
                android:padding="@dimen/_8sdp"
                android:src="@drawable/ic_shield_summary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_10sdp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvSummaryCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:textColor="@color/on_surface"
                    android:textSize="@dimen/_12ssp"
                    android:textStyle="bold"
                    tools:text="12 numbers blocked" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_2sdp"
                    android:text="@string/blocklist_summary_sub"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="@dimen/_10ssp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tvHeaderBlocked"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_18sdp"
            android:layout_marginTop="@dimen/_14sdp"
            android:letterSpacing="0.08"
            android:text="@string/blocklist_section_blocked"
            android:textAllCaps="true"
            android:textColor="@color/on_surface_variant"
            android:textSize="@dimen/_9ssp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/summaryStrip" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvBlocklist"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:paddingHorizontal="@dimen/_18sdp"
            android:paddingTop="@dimen/_6sdp"
            android:paddingBottom="@dimen/_88sdp"
            app:layout_constraintBottom_toTopOf="@id/bannerAdFrame"
            app:layout_constraintTop_toBottomOf="@id/tvHeaderBlocked"
            tools:listitem="@layout/item_blocklist" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabAdd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/_20sdp"
            android:contentDescription="@string/blocklist_add"
            android:src="@drawable/ic_add"
            app:backgroundTint="@color/primary"
            app:elevation="@dimen/_6sdp"
            app:layout_constraintBottom_toTopOf="@id/bannerAdFrame"
            app:layout_constraintEnd_toEndOf="parent"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Fab.Rounded"
            app:tint="@color/white" />

        <androidx.constraintlayout.widget.Group
            android:id="@+id/populatedGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:constraint_referenced_ids="summaryStrip,tvHeaderBlocked,rvBlocklist,fabAdd" />

        <!-- ===== EMPTY STATE: breathing icon + headline + the three methods ===== -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/emptyScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/_12sdp"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/bannerAdFrame"
            app:layout_constraintTop_toBottomOf="@id/topBar">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/_20sdp">

                <com.calleridapp.numberlookup.ui.common.PulseIconView
                    android:id="@+id/emptyIcon"
                    android:layout_width="@dimen/_74sdp"
                    android:layout_height="@dimen/_74sdp"
                    android:layout_marginTop="@dimen/_20sdp"
                    app:biv_disc="@drawable/bg_empty_circle_spam"
                    app:biv_icon="@drawable/ic_block_circle"
                    app:biv_iconSize="@dimen/_32sdp"
                    app:biv_ring="@drawable/bg_ring_spam" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_12sdp"
                    android:text="@string/blocklist_empty"
                    android:textColor="@color/on_surface"
                    android:textSize="@dimen/_14ssp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_4sdp"
                    android:gravity="center"
                    android:text="@string/blocklist_empty_subtitle"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="@dimen/_11ssp" />

                <include
                    android:id="@+id/emptyMethods"
                    layout="@layout/view_block_methods"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_22sdp" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Full-bleed hairline separating app content from the ad below -->
        <View
            android:id="@+id/adBannerDivider"
            style="@style/AdDivider"
            android:layout_width="0dp"
            app:layout_constraintBottom_toTopOf="@id/bannerAdFrame"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Bottom banner (auto-loaded by BaseActivity.showBottomBanner). -->
        <include
            layout="@layout/view_bottom_banner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
