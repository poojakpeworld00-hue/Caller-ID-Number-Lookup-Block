<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="42dp"
    android:layout_gravity="center"
    android:layout_margin="3dp"
    android:background="@drawable/pseudo_search_bar_bg"
    android:elevation="2dp">

    <ImageView
        android:id="@+id/search_bar_icon"
        android:layout_width="45dp"
        android:layout_height="40dp"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:contentDescription="@string/pseudo_widget_search_bar"
        android:elevation="5dp"
        android:padding="8dp"
        android:src="@drawable/ic_pseudo_search_vector" />

    <TextView
        android:id="@+id/search_bar_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_toEndOf="@+id/search_bar_icon"
        android:text="@string/pseudo_widget_search_bar_hint"
        android:textColor="@android:color/white"
        android:textSize="14sp" />

</RelativeLayout>
