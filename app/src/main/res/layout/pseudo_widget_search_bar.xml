<?xml version="1.0" encoding="utf-8"?>
<!--
    Search pill sitting on the home screen. Tapping anywhere on it opens the app search
    panel with the field already focused, so the whole pill is one target.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="44dp"
    android:layout_gravity="center"
    android:layout_margin="4dp"
    android:background="@drawable/pseudo_search_bar_bg"
    android:elevation="2dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="12dp">

    <ImageView
        android:id="@+id/search_bar_icon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:contentDescription="@string/pseudo_widget_search_bar"
        android:src="@drawable/ic_pseudo_search_vector" />

    <TextView
        android:id="@+id/search_bar_hint"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="@font/nunito_semibold"
        android:maxLines="1"
        android:text="@string/pseudo_widget_search_bar_hint"
        android:textColor="#e6ffffff"
        android:textSize="14sp" />

</LinearLayout>
