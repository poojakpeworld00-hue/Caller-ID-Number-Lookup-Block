<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <org.fossify.commons.views.MyTextView
        android:id="@+id/onboarding_skip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentTop="true"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:gravity="center"
        android:minWidth="48dp"
        android:minHeight="44dp"
        android:paddingHorizontal="10dp"
        android:text="@string/onboarding_skip"
        android:textColor="@color/cid_onb_muted"
        android:textSize="15sp" />

    <include
        android:id="@+id/onboarding_step_header"
        layout="@layout/view_onboarding_step_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_below="@id/onboarding_skip"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="4dp"
        android:visibility="gone" />


    <LinearLayout
        android:id="@+id/onboarding_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:paddingBottom="16dp">




        <org.fossify.commons.views.MyTextView
            android:id="@+id/onboarding_footnote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="40dp"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.3"
            android:text="@string/onb_default_footnote"
            android:textColor="@color/cid_onb_muted"
            android:textSize="12sp" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/onboarding_footer"
        android:layout_below="@id/onboarding_step_header"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="24dp">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/imageHero"
                    android:layout_width="@dimen/_58sdp"
                    android:layout_height="@dimen/_58sdp"
                    android:background="@drawable/button_background_rounded"
                    android:contentDescription="@null"
                    android:padding="@dimen/_15sdp"
                    android:layout_gravity="center"
                    android:scaleType="fitCenter"
                    android:src="@drawable/onb_home_unselected"
                    app:tint="@color/white" />

            </LinearLayout>

            <org.fossify.commons.views.MyTextView
                android:id="@+id/onboarding_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:letterSpacing="-0.02"
                android:lineSpacingMultiplier="1.1"
                android:text="@string/onb_default_title"
                android:textColor="@color/cid_onb_ink"
                android:textSize="27sp"
                android:textStyle="bold" />

            <org.fossify.commons.views.MyTextView
                android:id="@+id/onboarding_lead"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="6dp"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:lineSpacingMultiplier="1.35"
                android:text="@string/onb_default_lead"
                android:textColor="@color/cid_onb_muted"
                android:textSize="15sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/onboarding_set_default"
                style="@style/OnboardingButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/onboarding_set_default" />

            <View
                android:id="@+id/ad_native_divider"
                android:layout_marginTop="@dimen/_7ssp"
                style="@style/AdDivider" />

            <FrameLayout
                android:id="@+id/ad_native_frame"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.facebook.shimmer.ShimmerFrameLayout
                    android:id="@+id/ad_shimmer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#ccc">

                    <include layout="@layout/googlemidnative2" />

                </com.facebook.shimmer.ShimmerFrameLayout>
            </FrameLayout>

        </LinearLayout>

    </ScrollView>

</RelativeLayout>
