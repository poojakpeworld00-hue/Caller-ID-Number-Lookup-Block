<?xml version="1.0" encoding="utf-8"?>
<!-- Recent-call row as a card: verdict-tinted avatar, name + type/time, and a
     call action. Row background + avatar colors are set per verdict in CallAdapter
     (spam rows get a red-tinted container). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rowCall"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/_16sdp"
    android:layout_marginTop="@dimen/_6sdp"
    android:background="@drawable/bg_home_tile"
    android:clipToOutline="true"
    android:elevation="@dimen/_1sdp"
    android:foreground="?attr/selectableItemBackground"
    android:outlineAmbientShadowColor="@color/card_shadow"
    android:outlineSpotShadowColor="@color/card_shadow"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/_10sdp"
    android:paddingVertical="@dimen/_8sdp">

    <TextView
        android:id="@+id/tvAvatar"
        android:layout_width="@dimen/_34sdp"
        android:layout_height="@dimen/_34sdp"
        android:background="@drawable/bg_avatar"
        android:fontFamily="@font/nunito_extrabold"
        android:gravity="center"
        android:textColor="@color/on_primary_container"
        android:textSize="@dimen/_11ssp"
        tools:text="112" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_10sdp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/nunito_bold"
            android:maxLines="1"
            android:textColor="@color/on_surface"
            android:textSize="@dimen/_11ssp"
            tools:text="Emergency · 112" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_1sdp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivType"
                android:layout_width="@dimen/_11sdp"
                android:layout_height="@dimen/_11sdp"
                android:contentDescription="@string/call_incoming"
                android:src="@drawable/ic_call_received"
                app:tint="@color/on_surface_variant" />

            <TextView
                android:id="@+id/tvSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_4sdp"
                android:fontFamily="@font/nunito_regular"
                android:textColor="@color/on_surface_variant"
                android:textSize="@dimen/_9ssp"
                tools:text="Outgoing · Jul 13" />
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:id="@+id/btnCall"
        android:layout_width="@dimen/_32sdp"
        android:layout_height="@dimen/_32sdp"
        android:background="@drawable/bg_circle_surface"
        android:contentDescription="@string/action_call"
        android:padding="@dimen/_7sdp"
        android:src="@drawable/ph_phone"
        app:tint="@color/primary" />

    <!-- Shown instead of Call for unknown / unsaved numbers → opens Lookup. -->
    <TextView
        android:id="@+id/btnIdentify"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/_30sdp"
        android:background="@drawable/bg_cta_pill"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:paddingHorizontal="@dimen/_12sdp"
        android:text="@string/action_identify"
        android:textColor="@color/on_primary_container"
        android:textSize="@dimen/_10ssp"
        android:textStyle="bold"
        android:visibility="gone"
        tools:visibility="visible" />
</LinearLayout>
