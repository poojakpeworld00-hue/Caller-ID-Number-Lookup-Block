<?xml version="1.0" encoding="utf-8"?>
<!--
    Recents v2 — compact header, pill search, filter chips (All / Incoming /
    Outgoing / Missed), a labelled native ad, then verdict-card call rows with a
    Dialer FAB clear of the list. Matches the Home v2 language. Bottom nav +
    AdMob banner live in MainActivity (unchanged).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <!-- Compact header (pads the status-bar inset from RecentsFragment) -->
    <LinearLayout
        android:id="@+id/heroHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/_16sdp"
        android:paddingTop="@dimen/_10sdp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/nunito_extrabold"
            android:letterSpacing="-0.03"
            android:text="@string/nav_recents"
            android:textColor="@color/on_surface"
            android:textSize="@dimen/_16ssp" />

        <ImageView
            android:id="@+id/btnRecentsFilter"
            android:layout_width="@dimen/_32sdp"
            android:layout_height="@dimen/_32sdp"
            android:background="@drawable/bg_onb_circle_lavender"
            android:contentDescription="@string/filter_all"
            android:padding="@dimen/_8sdp"
            android:src="@drawable/ic_filter_list"
            app:tint="@color/on_primary_container" />
    </LinearLayout>

    <!-- Search pill -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_16sdp"
        android:layout_marginTop="@dimen/_10sdp"
        android:background="@drawable/bg_home_search"
        android:elevation="@dimen/_2sdp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:outlineAmbientShadowColor="@color/card_shadow"
        android:outlineSpotShadowColor="@color/card_shadow"
        android:paddingHorizontal="@dimen/_14sdp"
        android:paddingVertical="@dimen/_9sdp">

        <ImageView
            android:layout_width="@dimen/_16sdp"
            android:layout_height="@dimen/_16sdp"
            android:contentDescription="@string/recents_search_hint"
            android:src="@drawable/ic_search"
            app:tint="@color/on_surface_variant" />

        <EditText
            android:id="@+id/etSearch"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_8sdp"
            android:layout_weight="1"
            android:background="@null"
            android:hint="@string/recents_search_hint"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="@color/on_surface"
            android:textColorHint="@color/on_surface_variant"
            android:textSize="@dimen/_11ssp" />

        <ImageView
            android:id="@+id/btnClearSearch"
            android:layout_width="@dimen/_24sdp"
            android:layout_height="@dimen/_24sdp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_cancel"
            android:padding="@dimen/_5sdp"
            android:src="@drawable/ic_close"
            android:visibility="gone"
            app:tint="@color/on_surface_variant" />
    </LinearLayout>

    <!-- Filter chips -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_10sdp"
        android:overScrollMode="never"
        android:paddingHorizontal="@dimen/_16sdp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tabAll"
                style="@style/RecentFilterTab"
                android:drawableStart="@drawable/recent_all"
                android:text="@string/filter_all" />

            <TextView
                android:id="@+id/tabIncoming"
                style="@style/RecentFilterTab"
                android:drawableStart="@drawable/filter_incoming"
                android:text="@string/filter_incoming" />

            <TextView
                android:id="@+id/tabOutgoing"
                style="@style/RecentFilterTab"
                android:drawableStart="@drawable/filter_outgoing"
                android:text="@string/filter_outgoing" />

            <TextView
                android:id="@+id/tabMissed"
                style="@style/RecentFilterTab"
                android:layout_marginEnd="0dp"
                android:drawableStart="@drawable/ic_call_missed"
                android:text="@string/filter_missed" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Full-bleed hairline separating the filters from the ad below -->
    <View
        android:layout_marginTop="@dimen/_10sdp"    android:id="@+id/adNativeDivider"
        style="@style/AdDivider" />

    <!-- Labelled native ad -->
    <FrameLayout
        android:id="@+id/adNativeFrame"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_16sdp"
       >

        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/adShimmer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#ccc">

            <include layout="@layout/googlenativebanner" />
        </com.facebook.shimmer.ShimmerFrameLayout>
    </FrameLayout>
    <!-- Full-bleed hairline separating the quick actions from the ad below -->
    <View
        android:id="@+id/adNativeDivider1"
        style="@style/AdDivider" />
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvRecents"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/_4sdp"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/_70sdp"
            tools:listitem="@layout/item_call" />

        <TextView
            android:id="@+id/tvEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/recents_empty"
            android:textColor="@color/on_surface_variant"
            android:textSize="@dimen/_12ssp"
            android:visibility="gone" />

        <!-- Dialer FAB, clear of the rows -->
        <LinearLayout
            android:id="@+id/btnRecentsDial"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="@dimen/_16sdp"
            android:layout_marginBottom="@dimen/_16sdp"
            android:background="@drawable/bg_home_protection"
            android:clickable="true"
            android:elevation="@dimen/_6sdp"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:outlineAmbientShadowColor="@color/card_shadow"
            android:outlineSpotShadowColor="@color/card_shadow"
            android:paddingHorizontal="@dimen/_18sdp"
            android:paddingVertical="@dimen/_12sdp">

            <ImageView
                android:layout_width="@dimen/_16sdp"
                android:layout_height="@dimen/_16sdp"
                android:contentDescription="@string/quick_dialer"
                android:src="@drawable/ic_dialpad"
                app:tint="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_8sdp"
                android:text="@string/quick_dialer"
                android:textColor="@color/white"
                android:textSize="@dimen/_12ssp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Permission state -->
        <LinearLayout
            android:id="@+id/permState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/_32sdp"
            android:visibility="gone">

            <ImageView
                android:layout_width="@dimen/_60sdp"
                android:layout_height="@dimen/_60sdp"
                android:background="@drawable/bg_icon_box"
                android:contentDescription="@string/perm_calllog_title"
                android:padding="@dimen/_16sdp"
                android:src="@drawable/ic_history"
                app:tint="@color/primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_14sdp"
                android:text="@string/perm_calllog_title"
                android:textColor="@color/on_surface"
                android:textSize="@dimen/_13ssp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_6sdp"
                android:gravity="center"
                android:text="@string/perm_calllog_message"
                android:textColor="@color/on_surface_variant"
                android:textSize="@dimen/_11ssp" />

            <TextView
                android:id="@+id/btnGrant"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_16sdp"
                android:background="@drawable/bg_btn_primary"
                android:paddingHorizontal="@dimen/_24sdp"
                android:paddingVertical="@dimen/_10sdp"
                android:text="@string/action_grant"
                android:textColor="@color/white"
                android:textSize="@dimen/_12ssp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
