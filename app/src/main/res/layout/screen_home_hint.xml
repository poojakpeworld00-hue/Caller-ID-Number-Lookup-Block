<?xml version="1.0" encoding="utf-8"?>

<!--
    The coach hint shown OVER the system "Default home app" page while the set-default step
    waits. A full-screen dim scrim (rowMain) darkens that page, with the instruction card
    centred on top. Reuses the same view ids the hint code fills
    (TipSheetActivity.applyMode + RoleCoachActivity): guideTitleTvVw, guideDescTvVw,
    guideRowIconIvVw, guideRowNameTvVw, guideRowHintTvVw, animation_viewVw. A touch anywhere
    dismisses it.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/llMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#B3000000">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/overlayCardVw"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginHorizontal="@dimen/_26sdp"
        android:background="@drawable/form_home_hint_card"
        android:elevation="@dimen/_12sdp"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/_18sdp"
        android:paddingTop="@dimen/_18sdp"
        android:paddingBottom="@dimen/_18sdp">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp"
            android:background="@drawable/shape_overlay_row"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/_12sdp"
            android:paddingVertical="@dimen/_10sdp">

            <ImageView
                android:id="@+id/guideRowIconIv"
                android:layout_width="@dimen/_38sdp"
                android:layout_height="@dimen/_38sdp"
                android:contentDescription="@string/app_name"
                android:src="@mipmap/ic_launcher" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_12sdp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/guideRowNameTv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/figtree_semibold"
                    android:maxLines="1"
                    android:text="@string/app_name"
                    android:textColor="@color/on_surface"
                    android:textSize="@dimen/_11ssp" />

                <TextView
                    android:id="@+id/guideRowHintTv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_1sdp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/home_guide_row_hint"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="@dimen/_9ssp" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="@dimen/_60sdp"
                android:layout_height="@dimen/_64sdp"
                android:clipChildren="false">

                <View
                    android:id="@+id/hintRadio"
                    android:layout_width="@dimen/_30sdp"
                    android:layout_height="@dimen/_30sdp"
                    android:layout_gravity="center"
                    android:background="@drawable/glyph_radio" />

                <ImageView
                    android:id="@+id/hintHand"
                    android:layout_width="@dimen/_34sdp"
                    android:layout_height="@dimen/_34sdp"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginStart="@dimen/_18sdp"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    android:src="@drawable/glyph_hand_tap" />
            </FrameLayout>

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_12sdp"
            android:gravity="center"
            android:text="@string/overlay_guide_dismiss"
            android:textColor="@color/on_surface_variant"
            android:textSize="@dimen/_9ssp" />
    </androidx.appcompat.widget.LinearLayoutCompat>

</FrameLayout>
