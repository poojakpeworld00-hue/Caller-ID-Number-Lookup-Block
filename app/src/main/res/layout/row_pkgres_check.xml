<?xml version="1.0" encoding="utf-8"?>
<!-- One result row on the install / uninstall check: status dot, what was checked, what was found. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="40dp"
    android:orientation="horizontal">

    <View
        android:id="@+id/pkgresRowDotVw"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:background="@drawable/form_pkgres_dot" />

    <TextView
        android:id="@+id/pkgresRowTitleVw"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/pkgres_text_primary"
        android:textSize="13sp"
        tools:text="Location" />

    <TextView
        android:id="@+id/pkgresRowValueVw"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:fontFamily="@font/nunito_bold"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/pkgres_text_secondary"
        android:textSize="12sp"
        tools:text="Allowed" />
</LinearLayout>
