<?xml version="1.0" encoding="utf-8"?>
<!--
    Onboarding step 3 — "Search any number".
    A floating phone (obCard) searches a number: a search field, a radar with a
    rotating sweep (obSweep) and a green match blip (obBlip), then the resolved
    caller with a "CALLER FOUND" stamp (obStamp). Sits in a soft blue halo.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <ImageView
        android:layout_width="@dimen/_165sdp"
        android:layout_height="@dimen/_165sdp"
        android:layout_gravity="center"
        android:contentDescription="@null"
        android:src="@drawable/bg_onb_halo_blue" />

    <!-- searching pulse rings (blue, to match this step's theme) -->
    <View
        android:id="@+id/obRing1"
        android:layout_width="@dimen/_142sdp"
        android:layout_height="@dimen/_142sdp"
        android:layout_gravity="center"
        android:background="@drawable/bg_onb_ring_incoming" />

    <View
        android:id="@+id/obRing2"
        android:layout_width="@dimen/_142sdp"
        android:layout_height="@dimen/_142sdp"
        android:layout_gravity="center"
        android:background="@drawable/bg_onb_ring_incoming" />

    <LinearLayout
        android:id="@+id/obCard"
        android:layout_width="@dimen/_115sdp"
        android:layout_height="@dimen/_184sdp"
        android:layout_gravity="center"
        android:background="@drawable/bg_onb_phone_blue"
        android:clipChildren="false"
        android:elevation="@dimen/_6sdp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:outlineAmbientShadowColor="@color/card_shadow"
        android:outlineSpotShadowColor="@color/card_shadow"
        android:paddingHorizontal="@dimen/_8sdp"
        android:paddingTop="@dimen/_11sdp"
        android:paddingBottom="@dimen/_8sdp">

        <View
            android:layout_width="@dimen/_30sdp"
            android:layout_height="@dimen/_4sdp"
            android:layout_marginBottom="@dimen/_6sdp"
            android:background="@drawable/bg_onb_notch" />

        <!-- search field -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/_22sdp"
            android:background="@drawable/bg_onb_search_field"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/_8sdp">

            <ImageView
                android:layout_width="@dimen/_10sdp"
                android:layout_height="@dimen/_10sdp"
                android:contentDescription="@null"
                android:src="@drawable/ic_ob_search"
                app:tint="@color/on_surface_variant" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_4sdp"
                android:fontFamily="monospace"
                android:text="+1 415 555…"
                android:textColor="@color/on_surface_variant"
                android:textSize="@dimen/_6ssp"
                tools:ignore="HardcodedText" />
        </LinearLayout>

        <!-- radar -->
        <FrameLayout
            android:layout_width="@dimen/_64sdp"
            android:layout_height="@dimen/_64sdp"
            android:layout_marginTop="@dimen/_9sdp">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_onb_ring_scan" />

            <View
                android:layout_width="@dimen/_38sdp"
                android:layout_height="@dimen/_38sdp"
                android:layout_gravity="center"
                android:background="@drawable/bg_onb_ring_scan" />

            <ImageView
                android:id="@+id/obSweep"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:src="@drawable/ic_ob_sweep" />

            <TextView
                android:layout_width="@dimen/_26sdp"
                android:layout_height="@dimen/_26sdp"
                android:layout_gravity="center"
                android:background="@drawable/bg_splash_avatar"
                android:gravity="center"
                android:text="MJ"
                android:textColor="@color/white"
                android:textSize="@dimen/_7ssp"
                android:textStyle="bold"
                tools:ignore="HardcodedText" />

            <View
                android:id="@+id/obBlip"
                android:layout_width="@dimen/_7sdp"
                android:layout_height="@dimen/_7sdp"
                android:layout_gravity="top|end"
                android:layout_marginTop="@dimen/_8sdp"
                android:layout_marginEnd="@dimen/_5sdp"
                android:background="@drawable/bg_onb_blip" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8sdp"
            android:text="Michael Johnson"
            android:textColor="@color/on_surface"
            android:textSize="@dimen/_9ssp"
            android:textStyle="bold"
            tools:ignore="HardcodedText" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_1sdp"
            android:text="San Francisco, CA"
            android:textColor="@color/on_surface_variant"
            android:textSize="@dimen/_6ssp"
            android:textStyle="bold"
            tools:ignore="HardcodedText" />

        <Space
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/obStamp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chip_identified"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/_10sdp"
            android:paddingVertical="@dimen/_4sdp">

            <ImageView
                android:layout_width="@dimen/_9sdp"
                android:layout_height="@dimen/_9sdp"
                android:contentDescription="@null"
                android:src="@drawable/ic_check"
                app:tint="@color/identified_on" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_3sdp"
                android:text="CALLER FOUND"
                android:textColor="@color/identified_on"
                android:textSize="@dimen/_6ssp"
                android:textStyle="bold"
                tools:ignore="HardcodedText" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
