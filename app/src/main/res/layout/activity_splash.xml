<?xml version="1.0" encoding="utf-8"?>
<!--
    Splash — "Caller Information".
    A centred app icon breathes inside a dashed orbit ring while a blue AI-scan
    ring sweeps around it. Three caller-info elements pop in and then slowly
    orbit the icon (staying upright): an "Incoming call…" pill, a red "Fraud
    blocked" pill, and a green-verified caller avatar. Title + tagline rise in,
    a progress bar fills, and an ad-disclosure / secure-version footer sits at
    the bottom. All motion is driven from SplashActivity (UI only — navigation
    is owned by getData()).
-->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/splashRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_splash_hero"
        android:clipChildren="false"
        android:clipToPadding="false"
        tools:context=".ui.splash.LaunchActivity">

        <!-- ===== Ambient orbs + twinkling stars ===== -->
        <ImageView
            android:id="@+id/orb1"
            android:layout_width="@dimen/_150sdp"
            android:layout_height="@dimen/_150sdp"
            android:contentDescription="@null"
            android:src="@drawable/bg_splash_orb"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintHorizontal_bias="0.08"
            app:layout_constraintVertical_bias="0.10" />

        <ImageView
            android:id="@+id/orb2"
            android:layout_width="@dimen/_190sdp"
            android:layout_height="@dimen/_190sdp"
            android:contentDescription="@null"
            android:src="@drawable/bg_splash_orb"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintHorizontal_bias="0.96"
            app:layout_constraintVertical_bias="0.82" />

        <!-- Scattered organically across the upper "sky" (not one-per-corner). -->
        <View
            android:id="@+id/star1"
            android:layout_width="@dimen/_4sdp"
            android:layout_height="@dimen/_4sdp"
            android:background="@drawable/bg_splash_star"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintHorizontal_bias="0.24"
            app:layout_constraintVertical_bias="0.13" />

        <View
            android:id="@+id/star2"
            android:layout_width="@dimen/_3sdp"
            android:layout_height="@dimen/_3sdp"
            android:background="@drawable/bg_splash_star"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintHorizontal_bias="0.58"
            app:layout_constraintVertical_bias="0.08" />

        <View
            android:id="@+id/star3"
            android:layout_width="@dimen/_4sdp"
            android:layout_height="@dimen/_4sdp"
            android:background="@drawable/bg_splash_star"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintHorizontal_bias="0.80"
            app:layout_constraintVertical_bias="0.19" />

        <View
            android:id="@+id/star4"
            android:layout_width="@dimen/_3sdp"
            android:layout_height="@dimen/_3sdp"
            android:background="@drawable/bg_splash_star"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintHorizontal_bias="0.40"
            app:layout_constraintVertical_bias="0.27" />

        <!-- ===== Caller-info composition (icon + rings + orbiting elements) ===== -->
        <FrameLayout
            android:id="@+id/composition"
            android:layout_width="@dimen/_300sdp"
            android:layout_height="@dimen/_300sdp"
            android:alpha="0"
            android:clipChildren="false"
            android:clipToPadding="false"
            app:layout_constraintBottom_toTopOf="@id/tvAppName"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed">

            <!-- Dashed orbit ring -->
            <ImageView
                android:id="@+id/orbitRing"
                android:layout_width="@dimen/_240sdp"
                android:layout_height="@dimen/_240sdp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/bg_splash_orbit_ring" />

            <!-- Blue AI-scan ring around the icon -->
            <ImageView
                android:id="@+id/scanRing"
                android:layout_width="@dimen/_134sdp"
                android:layout_height="@dimen/_134sdp"
                android:layout_gravity="center"
                android:alpha="0"
                android:contentDescription="@null"
                android:src="@drawable/bg_splash_scan_arc" />

            <!-- Centred app icon tile -->
            <FrameLayout
                android:id="@+id/iconTile"
                android:layout_width="@dimen/_72sdp"
                android:layout_height="@dimen/_72sdp"
                android:layout_gravity="center"
                android:alpha="0"
                android:background="@drawable/bg_splash_icon_tile"
                android:elevation="@dimen/_10sdp">

                <ImageView
                    android:layout_width="@dimen/_42sdp"
                    android:layout_height="@dimen/_42sdp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_phone_solid" />
            </FrameLayout>

            <!-- Orbit layer: rotates as a whole; children counter-rotate to stay upright -->
            <FrameLayout
                android:id="@+id/orbitLayer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:clipChildren="false"
                android:clipToPadding="false">

                <!-- Incoming call pill (upper-left) -->
                <FrameLayout
                    android:id="@+id/incomingWrap"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center">

                    <LinearLayout
                        android:id="@+id/chipIncoming"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:alpha="0"
                        android:background="@drawable/bg_splash_pill"
                        android:elevation="@dimen/_6sdp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/_7sdp"
                        android:paddingTop="@dimen/_6sdp"
                        android:paddingEnd="@dimen/_11sdp"
                        android:paddingBottom="@dimen/_6sdp">

                        <FrameLayout
                            android:layout_width="@dimen/_20sdp"
                            android:layout_height="@dimen/_20sdp"
                            android:background="@drawable/bg_splash_incoming_dot">

                            <ImageView
                                android:layout_width="@dimen/_11sdp"
                                android:layout_height="@dimen/_11sdp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_phone_solid"
                                app:tint="@color/splash_incoming_icon" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_6sdp"
                            android:text="@string/splash_incoming_call"
                            android:textColor="@color/splash_pill_fg"
                            android:textSize="@dimen/_10ssp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </FrameLayout>

                <!-- Fraud blocked pill (lower-left) -->
                <FrameLayout
                    android:id="@+id/fraudWrap"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center">

                    <LinearLayout
                        android:id="@+id/chipFraud"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:alpha="0"
                        android:background="@drawable/bg_splash_pill"
                        android:elevation="@dimen/_6sdp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/_10sdp"
                        android:paddingTop="@dimen/_7sdp"
                        android:paddingEnd="@dimen/_11sdp"
                        android:paddingBottom="@dimen/_7sdp">

                        <ImageView
                            android:layout_width="@dimen/_13sdp"
                            android:layout_height="@dimen/_13sdp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_fraud_block" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_6sdp"
                            android:text="@string/splash_fraud_blocked"
                            android:textColor="@color/splash_fraud_fg"
                            android:textSize="@dimen/_10ssp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </FrameLayout>

                <!-- Verified caller avatar (right) -->
                <FrameLayout
                    android:id="@+id/avatarWrap"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center">

                    <FrameLayout
                        android:id="@+id/avatarInner"
                        android:layout_width="@dimen/_54sdp"
                        android:layout_height="@dimen/_54sdp"
                        android:alpha="0"
                        android:elevation="@dimen/_6sdp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_splash_avatar_ring"
                            android:gravity="center"
                            android:text="@string/splash_avatar_initials"
                            android:textColor="@color/white"
                            android:textSize="@dimen/_14ssp"
                            android:textStyle="bold" />

                        <FrameLayout
                            android:layout_width="@dimen/_22sdp"
                            android:layout_height="@dimen/_22sdp"
                            android:layout_gravity="bottom|end"
                            android:background="@drawable/bg_splash_check">

                            <ImageView
                                android:layout_width="@dimen/_12sdp"
                                android:layout_height="@dimen/_12sdp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_check"
                                app:tint="@color/white" />
                        </FrameLayout>
                    </FrameLayout>
                </FrameLayout>
            </FrameLayout>
        </FrameLayout>

        <!-- ===== Title + tagline ===== -->
        <TextView
            android:id="@+id/tvAppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp"
            android:alpha="0"
            android:letterSpacing="-0.02"
            android:text="@string/splash_title"
            android:textColor="@color/white"
            android:textSize="@dimen/_28ssp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@id/tvTagline"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/composition" />

        <TextView
            android:id="@+id/tvTagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_5sdp"
            android:alpha="0"
            android:gravity="center"
            android:text="@string/splash_tagline"
            android:textColor="@color/splash_tagline_on"
            android:textSize="@dimen/_12ssp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvAppName" />

        <!-- ===== Progress bar (fills as the app boots) ===== -->
        <View
            android:id="@+id/progressTrack"
            android:layout_width="@dimen/_110sdp"
            android:layout_height="@dimen/_4sdp"
            android:layout_marginBottom="@dimen/_20sdp"
            android:alpha="0"
            android:background="@drawable/bg_splash_bar_track"
            app:layout_constraintBottom_toTopOf="@id/footer"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <View
            android:id="@+id/progressFill"
            android:layout_width="@dimen/_8sdp"
            android:layout_height="@dimen/_4sdp"
            android:background="@drawable/bg_splash_bar_fill"
            app:layout_constraintBottom_toBottomOf="@id/progressTrack"
            app:layout_constraintStart_toStartOf="@id/progressTrack"
            app:layout_constraintTop_toTopOf="@id/progressTrack" />

        <!-- ===== Ad disclosure + secure version footer ===== -->
        <LinearLayout
            android:id="@+id/footer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/_16sdp"
            android:alpha="0"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/splash_footer"
                android:textColor="@color/splash_footer"
                android:textSize="@dimen/_9ssp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_5sdp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/_11sdp"
                    android:layout_height="@dimen/_11sdp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_shield_check" />

                <TextView
                    android:id="@+id/tvSecureVersion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_4sdp"
                    android:letterSpacing="0.04"
                    android:textColor="@color/splash_footer"
                    android:textSize="@dimen/_9ssp"
                    android:textStyle="bold"
                    tools:text="Secure v1.2" />
            </LinearLayout>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
