<?xml version="1.0" encoding="utf-8"?>
<!--
    Full-Screen-Intent priming Dialog (design: FSI Incoming Call Dialog). The
    incoming-call card floats in a small halo of glow + pulsing orbit rings,
    above remote-driven title/description and the FSI-blue "Enable Now" CTA.
    Card springs up, rings/glow pulse, CTA breathes (driven by FsiPrimingDialog).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fsDialogCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/_14sdp"
    android:paddingTop="@dimen/_12sdp"
    android:paddingBottom="@dimen/_14sdp">

    <!-- Hero: floating card in a small halo of glow + orbit rings -->
    <FrameLayout
        android:id="@+id/fsDialogHero"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_4sdp">

        <ImageView
            android:id="@+id/fsDialogGlow"
            android:layout_width="@dimen/_150sdp"
            android:layout_height="@dimen/_150sdp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/bg_fsi_glow" />

        <ImageView
            android:id="@+id/fsDialogOrbit1"
            android:layout_width="@dimen/_130sdp"
            android:layout_height="@dimen/_130sdp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/bg_fsi_orbit_ring" />

        <ImageView
            android:id="@+id/fsDialogOrbit2"
            android:layout_width="@dimen/_130sdp"
            android:layout_height="@dimen/_130sdp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/bg_fsi_orbit_ring" />

        <include
            layout="@layout/view_fsi_call_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginHorizontal="@dimen/_22sdp" />
    </FrameLayout>

    <TextView
        android:id="@+id/fsDialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_14sdp"
        android:gravity="center"
        android:letterSpacing="-0.01"
        android:text="@string/fsi_screen_title"
        android:textColor="@color/on_surface"
        android:textSize="@dimen/_13ssp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/fsDialogDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_5sdp"
        android:gravity="center"
        android:lineSpacingMultiplier="1.35"
        android:text="@string/fsi_screen_desc"
        android:textColor="@color/on_surface_variant"
        android:textSize="@dimen/_10ssp" />

    <TextView
        android:id="@+id/fsDialogButton"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_44sdp"
        android:layout_marginTop="@dimen/_14sdp"
        android:background="@drawable/bg_fsi_cta"
        android:gravity="center"
        android:text="@string/fsi_enable_now"
        android:textColor="#FFFFFF"
        android:textSize="@dimen/_12ssp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/fsDialogLater"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:paddingHorizontal="@dimen/_20sdp"
        android:paddingVertical="@dimen/_9sdp"
        android:text="@string/fsi_not_now"
        android:textColor="@color/fsi_not_now"
        android:textSize="@dimen/_10ssp" />
</LinearLayout>
