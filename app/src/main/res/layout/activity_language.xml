<?xml version="1.0" encoding="utf-8"?>
<!--
    Language — "Language + empty state".
    Toolbar (back · title · info · filled confirm ✓) over two grouped cards:
    a compact "Suggested" list and a scrollable "All languages" list, each row
    56dp with the native name leading. Tapping a row previews the selection
    (radio fills, row tints); the ✓ button confirms and applies. The native ad
    stays pinned below the list as a standard labelled card — never mistakable
    for the confirm action.
-->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/languageRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingTop="@dimen/_10sdp"
        android:background="@color/background"
        tools:context=".ui.language.LanguageActivity">

        <!-- ===== Toolbar ===== -->
        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="@dimen/_30sdp"
            android:layout_height="@dimen/_30sdp"
            android:layout_marginStart="@dimen/_8sdp"
            android:visibility="gone"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/onboarding_skip"
            android:src="@drawable/ic_arrow_back"
            app:layout_constraintBottom_toBottomOf="@id/tvTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvTitle"
            app:tint="@color/on_surface" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_12sdp"
            android:letterSpacing="-0.01"
            android:text="@string/settings_language"
            android:textColor="@color/on_surface"
            android:textSize="@dimen/_15ssp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/btnContinue"
            app:layout_constraintEnd_toStartOf="@id/btnInfo"
            app:layout_constraintStart_toEndOf="@id/btnBack"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/btnInfo"
            android:layout_width="@dimen/_30sdp"
            android:layout_height="@dimen/_30sdp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/language_info_title"
            android:padding="@dimen/_6sdp"
            android:src="@drawable/ic_info"
            app:layout_constraintBottom_toBottomOf="@id/btnContinue"
            app:layout_constraintEnd_toStartOf="@id/btnContinue"
            app:layout_constraintTop_toTopOf="@id/btnContinue"
            app:tint="@color/on_surface_variant" />

        <!-- Filled confirm: primary disc + white check (a real button, not a bare glyph). -->
        <ImageView
            android:id="@+id/btnContinue"
            android:layout_width="@dimen/_30sdp"
            android:layout_height="@dimen/_30sdp"
            android:layout_marginEnd="@dimen/_10sdp"
            android:background="@drawable/bg_circle_primary"
            android:contentDescription="@string/language_continue"
            android:elevation="@dimen/_4sdp"
            android:padding="@dimen/_8sdp"
            android:src="@drawable/ic_check"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/on_primary" />

        <!-- ===== Suggested + All languages — one continuous scroll ===== -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/scroll"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/_10sdp"
            app:layout_constraintBottom_toTopOf="@id/adNativeFrame"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnContinue">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Suggested -->
                <TextView
                    android:id="@+id/tvSuggested"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_18sdp"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:letterSpacing="0.08"
                    android:text="@string/language_suggested"
                    android:textAllCaps="true"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="@dimen/_10ssp"
                    android:textStyle="bold" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvSuggested"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/_12sdp"
                    android:layout_marginTop="@dimen/_6sdp"
                    android:background="@drawable/bg_search_pill"
                    android:clipToOutline="true"
                    android:clipToPadding="false"
                    android:elevation="@dimen/_1sdp"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never"
                    android:paddingHorizontal="@dimen/_6sdp"
                    android:paddingVertical="@dimen/_6sdp"
                    tools:itemCount="2"
                    tools:listitem="@layout/item_language" />

                <!-- All languages -->
                <TextView
                    android:id="@+id/tvAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_18sdp"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:letterSpacing="0.08"
                    android:text="@string/language_all"
                    android:textAllCaps="true"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="@dimen/_10ssp"
                    android:textStyle="bold" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvLanguages"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/_12sdp"
                    android:layout_marginTop="@dimen/_6sdp"
                    android:background="@drawable/bg_search_pill"
                    android:clipToOutline="true"
                    android:clipToPadding="false"
                    android:elevation="@dimen/_1sdp"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never"
                    android:paddingHorizontal="@dimen/_6sdp"
                    android:paddingVertical="@dimen/_6sdp"
                    tools:listitem="@layout/item_language" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Full-bleed hairline separating the list from the ad below -->
        <View
            android:id="@+id/adNativeDivider"
            style="@style/AdDivider"
            android:layout_width="0dp"
            app:layout_constraintBottom_toTopOf="@id/adNativeFrame"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- ===== Native ad (labelled card, pinned below the list) ===== -->
        <FrameLayout
            android:id="@+id/adNativeFrame"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/adShimmer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#ccc">

                <include layout="@layout/googlebignative" />

            </com.facebook.shimmer.ShimmerFrameLayout>
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
