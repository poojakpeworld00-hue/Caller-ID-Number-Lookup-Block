<?xml version="1.0" encoding="utf-8"?>
<!--
    Home v2. Compact one-row header, a pill search with the +91 selector, the
    app's own Protection card in the hero slot, four single-language quick
    actions, the native ad demoted to a labelled card below them, then Recent
    activity. Bottom nav + AdMob banner live in MainActivity (unchanged).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <!-- Compact header (pads the status-bar inset from HomeFragment) -->
    <LinearLayout
        android:id="@+id/heroHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/_16sdp"
        android:paddingTop="@dimen/_8sdp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_greeting"
                android:textColor="@color/on_surface_variant"
                android:textSize="@dimen/_9ssp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/nunito_extrabold"
                android:letterSpacing="-0.02"
                android:text="@string/home_brand"
                android:textColor="@color/on_surface"
                android:textSize="@dimen/_16ssp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnSettings"
            android:layout_width="@dimen/_32sdp"
            android:layout_height="@dimen/_32sdp"
            android:background="@drawable/bg_onb_circle_lavender"
            android:contentDescription="@string/nav_settings"
            android:padding="@dimen/_8sdp"
            android:src="@drawable/ph_gear_six"
            app:tint="@color/on_primary_container" />
    </LinearLayout>

    <!-- Protection card — Claude Design hero C's banner: shield + title/subtitle +
         chevron. Fixed above the scroll area, matching the design's order (banner
         above the search pill) while keeping the header/search/hint's existing
         non-scrolling behavior. -->
    <LinearLayout
        android:id="@+id/cardProtection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_16sdp"
        android:layout_marginTop="@dimen/_9sdp"
        android:background="@drawable/bg_home_protection"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/_16sdp"
        android:paddingVertical="@dimen/_14sdp">

        <ImageView
            android:layout_width="@dimen/_22sdp"
            android:layout_height="@dimen/_22sdp"
            android:contentDescription="@null"
            android:src="@drawable/ph_shield_check"
            app:tint="@color/cid_g_050" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_10sdp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/nunito_extrabold"
                android:text="@string/home_protection_title"
                android:textColor="@color/cid_g_050"
                android:textSize="@dimen/_13ssp" />

            <TextView
                android:id="@+id/tvProtectionSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_1sdp"
                android:alpha="0.7"
                android:fontFamily="@font/nunito_regular"
                android:textColor="@color/cid_g_050"
                android:textSize="@dimen/_10ssp"
                tools:text="128 spam calls blocked this week" />
        </LinearLayout>

        <ImageView
            android:layout_width="@dimen/_14sdp"
            android:layout_height="@dimen/_14sdp"
            android:alpha="0.8"
            android:contentDescription="@null"
            android:src="@drawable/ph_caret_right"
            app:tint="@color/cid_g_050" />
    </LinearLayout>

    <!-- Search pill with the +91 country selector -->
    <LinearLayout
        android:id="@+id/searchBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_16sdp"
        android:layout_marginTop="@dimen/_10sdp"
        android:background="@drawable/bg_home_search"
        android:elevation="@dimen/_10sdp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:outlineAmbientShadowColor="@color/card_shadow"
        android:outlineSpotShadowColor="@color/card_shadow"
        android:paddingStart="@dimen/_10sdp"
        android:paddingEnd="@dimen/_6sdp"
        android:paddingVertical="@dimen/_6sdp">

        <LinearLayout
            android:id="@+id/llHomeCountry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/_4sdp"
            android:paddingVertical="@dimen/_6sdp">

            <TextView
                android:id="@+id/tvHomeFlag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:textSize="@dimen/_12ssp"
                tools:text="🇮🇳" />

            <TextView
                android:id="@+id/tvHomeDial"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="@dimen/_4sdp"
                android:drawableEnd="@drawable/ph_caret_down"
                android:drawablePadding="@dimen/_2sdp"
                android:fontFamily="@font/nunito_bold"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:textColor="@color/on_surface"
                android:textSize="@dimen/_11ssp"
                tools:text="+91" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="@dimen/_22sdp"
            android:layout_marginStart="@dimen/_6sdp"
            android:layout_marginEnd="@dimen/_10sdp"
            android:background="@color/outline" />

        <EditText
            android:id="@+id/etHomeSearch"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:fontFamily="@font/nunito_regular"
            android:hint="@string/home_search_hint"
            android:imeOptions="actionSearch"
            android:importantForAutofill="no"
            android:inputType="phone"
            android:maxLines="1"
            android:textColor="@color/on_surface"
            android:textColorHint="@color/on_surface_variant"
            android:textSize="@dimen/_11ssp" />

        <ImageView
            android:id="@+id/btnHomeSearch"
            android:layout_width="@dimen/_34sdp"
            android:layout_height="@dimen/_34sdp"
            android:background="@drawable/bg_circle_primary"
            android:contentDescription="@string/lookup_hint"
            android:padding="@dimen/_9sdp"
            android:src="@drawable/ph_magnifying_glass"
            app:tint="@color/on_primary" />
    </LinearLayout>

    <!-- Permission hint: appears after the first-run permission sheet is
         dismissed ("Not now"/swipe) with permissions still pending. "Manage"
         reopens the sheet. Hidden automatically once everything is granted. -->
    <LinearLayout
        android:id="@+id/llPermHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_16sdp"
        android:layout_marginTop="@dimen/_10sdp"
        android:background="@drawable/bg_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/_12sdp"
        android:paddingEnd="@dimen/_6sdp"
        android:paddingVertical="@dimen/_8sdp"
        android:visibility="gone"
        tools:visibility="visible">

        <ImageView
            android:layout_width="@dimen/_18sdp"
            android:layout_height="@dimen/_18sdp"
            android:contentDescription="@null"
            android:src="@drawable/ph_shield_check"
            app:tint="@color/primary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_8sdp"
            android:layout_weight="1"
            android:text="@string/home_perm_hint"
            android:textColor="@color/on_surface"
            android:textSize="@dimen/_10ssp" />

        <TextView
            android:id="@+id/btnPermManage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_8sdp"
            android:background="@drawable/bg_btn_primary"
            android:paddingHorizontal="@dimen/_14sdp"
            android:paddingVertical="@dimen/_6sdp"
            android:text="@string/home_perm_manage"
            android:textColor="@color/white"
            android:textSize="@dimen/_10ssp"
            android:textStyle="bold" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/_16sdp">

            <!-- Quick actions — Claude Design "actions 3": one shared card, split cells. -->
            <LinearLayout
                android:id="@+id/quickActionsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_16sdp"
                android:layout_marginTop="@dimen/_10sdp"
                android:background="@drawable/bg_home_tile"
                android:baselineAligned="false"
                android:elevation="@dimen/_1sdp"
                android:orientation="horizontal"
                android:outlineAmbientShadowColor="@color/card_shadow"
                android:outlineSpotShadowColor="@color/card_shadow"
                android:paddingHorizontal="@dimen/_4sdp"
                android:paddingTop="@dimen/_14sdp"
                android:paddingBottom="@dimen/_12sdp">

                <include
                    android:id="@+id/qaDialer"
                    layout="@layout/item_quick_action"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <include
                    android:id="@+id/qaLookup"
                    layout="@layout/item_quick_action"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <include
                    android:id="@+id/qaBlocklist"
                    layout="@layout/item_quick_action"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <include
                    android:id="@+id/qaTools"
                    layout="@layout/item_quick_action"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />
            </LinearLayout>

            <!-- Full-bleed hairline separating the quick actions from the ad below -->
            <View
                android:id="@+id/adNativeDivider"
                android:layout_marginTop="@dimen/_12sdp"
                style="@style/AdDivider" />

            <!-- Native ad, relocated below the quick actions -->
            <FrameLayout
                android:id="@+id/adRecentBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_16sdp"
               >

                <com.facebook.shimmer.ShimmerFrameLayout
                    android:id="@+id/adRecentShimmer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#ccc">

                    <include layout="@layout/googlenativebanner" />
                </com.facebook.shimmer.ShimmerFrameLayout>
            </FrameLayout>
            <!-- Full-bleed hairline separating the quick actions from the ad below -->
            <View
                android:id="@+id/adNativeDivider1"
                style="@style/AdDivider" />
            <!-- Recent activity header -->
            <LinearLayout
                android:id="@+id/recentHeaderRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_16sdp"
                android:layout_marginTop="@dimen/_12sdp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/nunito_extrabold"
                    android:letterSpacing="-0.01"
                    android:text="@string/home_recent_activity"
                    android:textColor="@color/on_surface"
                    android:textSize="@dimen/_12ssp" />

                <TextView
                    android:id="@+id/tvSeeAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:fontFamily="@font/nunito_semibold"
                    android:paddingHorizontal="@dimen/_4sdp"
                    android:paddingVertical="@dimen/_2sdp"
                    android:text="@string/home_see_all"
                    android:textColor="@color/primary"
                    android:textSize="@dimen/_10ssp" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvRecent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_2sdp"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_call" />

            <!-- Shown when call-log permission is not granted -->
            <LinearLayout
                android:id="@+id/llRecentPermission"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_20sdp"
                android:layout_marginTop="@dimen/_8sdp"
                android:background="@drawable/bg_card"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/_20sdp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="@dimen/_46sdp"
                    android:layout_height="@dimen/_46sdp"
                    android:background="@drawable/bg_icon_box"
                    android:contentDescription="@string/perm_calllog_title"
                    android:padding="@dimen/_12sdp"
                    android:src="@drawable/ph_clock_counter_clockwise"
                    app:tint="@color/primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:fontFamily="@font/nunito_extrabold"
                    android:text="@string/perm_calllog_title"
                    android:textColor="@color/on_surface"
                    android:textSize="@dimen/_13ssp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_4sdp"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.3"
                    android:text="@string/perm_calllog_message"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="@dimen/_11ssp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAllowCallLog"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_14sdp"
                    android:text="@string/perm_allow"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    app:backgroundTint="@color/primary"
                    app:cornerRadius="@dimen/_22sdp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
