<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/batteryRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background"
        tools:context=".ui.tools.PowerGaugeActivity">

        <!-- Top bar -->
        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/_8sdp"
            android:paddingVertical="@dimen/_6sdp"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="@dimen/_40sdp"
                android:layout_height="@dimen/_40sdp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/onboarding_skip"
                android:padding="@dimen/_8sdp"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/on_surface" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/battery_activity_title"
                android:textColor="@color/on_surface"
                android:textSize="@dimen/_14ssp"
                android:textStyle="bold" />
        </LinearLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:paddingHorizontal="@dimen/_16sdp"
            android:paddingBottom="@dimen/_16sdp"
            app:layout_constraintBottom_toTopOf="@id/bannerAdFrame"
            app:layout_constraintTop_toBottomOf="@id/topBar">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layoutAnimation="@anim/tool_layout_in"
                android:orientation="vertical">



                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_6sdp"
                    android:lineSpacingMultiplier="1.3"
                    android:text="@string/battery_activity_sub"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="@dimen/_11ssp" />
                <!-- Mid native (scrolls with content) -->
                <FrameLayout
                    android:id="@+id/adNativeFrame"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_10sdp">

                    <com.facebook.shimmer.ShimmerFrameLayout
                        android:id="@+id/adShimmer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#ccc">

                        <include layout="@layout/googlemidnative" />
                    </com.facebook.shimmer.ShimmerFrameLayout>
                </FrameLayout>
                <!-- Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:background="@drawable/bg_card_border"
                    android:orientation="vertical"
                    android:padding="@dimen/_18sdp">

                    <!-- Secured pill -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_pill"
                        android:backgroundTint="@color/primary_container"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="@dimen/_10sdp"
                        android:paddingVertical="@dimen/_5sdp">

                        <ImageView
                            android:layout_width="@dimen/_13sdp"
                            android:layout_height="@dimen/_13sdp"
                            android:contentDescription="@string/battery_secured"
                            android:src="@drawable/ic_verified_user"
                            app:tint="@color/primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_5sdp"
                            android:letterSpacing="0.04"
                            android:text="@string/battery_secured"
                            android:textAllCaps="true"
                            android:textColor="@color/primary"
                            android:textSize="@dimen/_8ssp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Level + battery glyph -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_12sdp"
                        android:baselineAligned="false"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="bottom"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvLevel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/on_surface"
                                android:textSize="@dimen/_34ssp"
                                android:textStyle="bold"
                                tools:text="84" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/_2sdp"
                                android:layout_marginBottom="@dimen/_8sdp"
                                android:text="%"
                                android:textColor="@color/on_surface_variant"
                                android:textSize="@dimen/_16ssp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <com.airbnb.lottie.LottieAnimationView
                            android:layout_width="@dimen/_64sdp"
                            android:layout_height="@dimen/_64sdp"
                            android:contentDescription="@string/tools_battery"
                            app:lottie_autoPlay="true"
                            app:lottie_loop="true"
                            app:lottie_rawRes="@raw/anim_battery" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_1sdp"
                        android:layout_marginVertical="@dimen/_16sdp"
                        android:alpha="0.15"
                        android:background="@color/on_surface_variant" />

                    <!-- Row 1: Voltage / Temperature / Health -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <LinearLayout style="@style/BatteryStat">

                            <TextView style="@style/BatteryStatLabel" android:text="@string/battery_voltage" />

                            <TextView
                                android:id="@+id/tvVoltage"
                                style="@style/BatteryStatValue"
                                tools:text="3.8V" />
                        </LinearLayout>

                        <LinearLayout style="@style/BatteryStat">

                            <TextView style="@style/BatteryStatLabel" android:text="@string/battery_temp" />

                            <TextView
                                android:id="@+id/tvTemp"
                                style="@style/BatteryStatValue"
                                tools:text="32°C" />
                        </LinearLayout>

                        <LinearLayout style="@style/BatteryStat">

                            <TextView style="@style/BatteryStatLabel" android:text="@string/battery_health" />

                            <TextView
                                android:id="@+id/tvHealth"
                                style="@style/BatteryStatValue"
                                android:textColor="@color/primary"
                                tools:text="Great" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Row 2: Status / Power source / Technology -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_18sdp"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <LinearLayout style="@style/BatteryStat">

                            <TextView style="@style/BatteryStatLabel" android:text="@string/battery_status" />

                            <TextView
                                android:id="@+id/tvStatus"
                                style="@style/BatteryStatValue"
                                tools:text="Charging" />
                        </LinearLayout>

                        <LinearLayout style="@style/BatteryStat">

                            <TextView style="@style/BatteryStatLabel" android:text="@string/battery_plugged" />

                            <TextView
                                android:id="@+id/tvPlugged"
                                style="@style/BatteryStatValue"
                                tools:text="AC" />
                        </LinearLayout>

                        <LinearLayout style="@style/BatteryStat">

                            <TextView style="@style/BatteryStatLabel" android:text="@string/battery_tech" />

                            <TextView
                                android:id="@+id/tvTech"
                                style="@style/BatteryStatValue"
                                tools:text="Li-ion" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Full-bleed hairline separating app content from the ad below -->
        <View
            android:id="@+id/adBannerDivider"
            style="@style/AdDivider"
            android:layout_width="0dp"
            app:layout_constraintBottom_toTopOf="@id/bannerAdFrame"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Bottom adaptive banner (auto-loaded by BaseActivity, type from ScreenAds config). -->
        <include
            layout="@layout/view_bottom_banner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
