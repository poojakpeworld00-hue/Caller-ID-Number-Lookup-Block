<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <View
        android:id="@+id/progress_step_1"
        android:layout_width="0dp"
        android:layout_height="4dp"
        android:layout_weight="1"
        android:background="@drawable/onboarding_progress_active" />

    <View
        android:layout_width="8dp"
        android:layout_height="1dp" />

    <View
        android:id="@+id/progress_step_2"
        android:layout_width="0dp"
        android:layout_height="4dp"
        android:layout_weight="1"
        android:background="@drawable/onboarding_progress_inactive" />

    <View
        android:layout_width="8dp"
        android:layout_height="1dp" />

    <View
        android:id="@+id/progress_step_3"
        android:layout_width="0dp"
        android:layout_height="4dp"
        android:layout_weight="1"
        android:background="@drawable/onboarding_progress_inactive" />

    <View
        android:layout_width="8dp"
        android:layout_height="1dp" />

    <View
        android:id="@+id/progress_step_4"
        android:layout_width="0dp"
        android:layout_height="4dp"
        android:layout_weight="1"
        android:background="@drawable/onboarding_progress_inactive" />

</LinearLayout>
