<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <org.fossify.commons.views.MyTextView
        android:id="@+id/onboarding_skip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:gravity="center"
        android:minWidth="48dp"
        android:minHeight="44dp"
        android:paddingHorizontal="10dp"
        android:text="@string/onboarding_skip"
        android:textColor="@color/cid_onb_muted"
        android:textSize="15sp" />

    <include
        android:id="@+id/onboarding_step_header"
        layout="@layout/view_onboarding_step_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_below="@id/onboarding_skip"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="4dp"
        android:visibility="gone" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/onboarding_step_header"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center_horizontal"
            android:orientation="vertical">


            <RelativeLayout
                android:layout_marginHorizontal="15dp"
                android:id="@+id/onboarding_hero"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_100sdp"
                android:clipChildren="false"
                android:clipToPadding="false">

                <View
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentTop="true"
                    android:layout_alignParentEnd="true"
                    android:layout_marginEnd="-26dp"
                    android:background="@drawable/shape_onb_blob_square" />

                <View
                    android:id="@+id/onboarding_halo"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_centerHorizontal="true"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/shape_onb_blob" />

                <ImageView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_alignParentStart="true"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="46dp"
                    android:alpha="0.45"
                    android:contentDescription="@null"
                    android:rotation="-18"
                    android:src="@drawable/holder_phone"
                    android:tint="@color/cid_onb_card_stroke" />

                <ImageView
                    android:id="@+id/onboarding_shield"
                    android:layout_width="92dp"
                    android:layout_height="60dp"
                    android:layout_centerHorizontal="true"
                    android:layout_marginTop="34dp"
                    android:contentDescription="@null"
                    android:src="@drawable/glyph_cid_shield_phone" />

                <ImageView
                    android:id="@+id/onboarding_badge"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_alignEnd="@id/onboarding_shield"
                    android:layout_alignBottom="@id/onboarding_shield"
                    android:layout_marginEnd="-12dp"
                    android:layout_marginBottom="-4dp"
                    android:background="@drawable/shape_onb_check_badge"
                    android:contentDescription="@null"
                    android:padding="18dp"
                    android:src="@drawable/glyph_cid_tick"
                    android:tint="@color/cid_onb_on_accent" />

            </RelativeLayout>

            <org.fossify.commons.views.MyTextView
                android:id="@+id/onboarding_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="center"
                android:letterSpacing="-0.02"
                android:text="@string/onb_welcome_title"
                android:textColor="@color/cid_onb_ink"
                android:textSize="34sp"
                android:textStyle="bold" />

            <org.fossify.commons.views.MyTextView
                android:id="@+id/onboarding_lead"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="30dp"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:lineSpacingMultiplier="1.35"
                android:text="@string/onb_welcome_lead"
                android:textColor="@color/cid_onb_muted"
                android:textSize="15sp" />


            <!-- The four launcher gestures, ported from the reference Ready screen: one chevron
                 rotated per direction, bound in HelloStepActivity.bindGestureTiles. -->
            <LinearLayout
                android:layout_marginHorizontal="15dp"
                android:id="@+id/onboarding_gestures"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <include
                    android:id="@+id/tileSwipeUp"
                    layout="@layout/cell_gesture_tile"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <Space
                    android:layout_width="6dp"
                    android:layout_height="1dp" />

                <include
                    android:id="@+id/tileSwipeRight"
                    layout="@layout/cell_gesture_tile"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <Space
                    android:layout_width="6dp"
                    android:layout_height="1dp" />

                <include
                    android:id="@+id/tileSwipeDown"
                    layout="@layout/cell_gesture_tile"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <Space
                    android:layout_width="6dp"
                    android:layout_height="1dp" />

                <include
                    android:id="@+id/tileSwipeLeft"
                    layout="@layout/cell_gesture_tile"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

            </LinearLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/onboarding_continue"
                style="@style/OnboardingButton"
                android:layout_marginHorizontal="15dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="10dp"
                android:text="@string/onboarding_continue" />

            <LinearLayout
                android:id="@+id/onboarding_footer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <View
                    android:id="@+id/ad_native_divider"
                    style="@style/AdDivider" />

                <FrameLayout
                    android:id="@+id/ad_native_frame"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <com.facebook.shimmer.ShimmerFrameLayout
                        android:id="@+id/ad_shimmer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#ccc">

                        <include layout="@layout/googlemidnative2" />

                    </com.facebook.shimmer.ShimmerFrameLayout>
                </FrameLayout>


            </LinearLayout>
        </LinearLayout>

    </ScrollView>

</RelativeLayout>
