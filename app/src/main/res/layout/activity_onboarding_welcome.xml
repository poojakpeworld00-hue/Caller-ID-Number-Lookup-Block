<?xml version="1.0" encoding="utf-8"?><!--
    Onboarding step 1, built to the reference screen: Skip in the corner, the shield
    mark on its pale halo with a verified badge, the Welcome heading and lead, three
    feature tiles, and the ink CTA.

    No permission toggles here any more — the reference has none, so notifications and
    phone state are requested straight off Continue instead (see OnboardingWelcomeActivity).
-->
<!-- fitsSystemWindows keeps Skip clear of the status bar and the CTA clear of the
     gesture bar; the theme draws both system bars transparent. -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <org.fossify.commons.views.MyTextView
        android:id="@+id/onboarding_skip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentTop="true"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:gravity="center"
        android:minWidth="48dp"
        android:minHeight="44dp"
        android:paddingHorizontal="10dp"
        android:text="@string/onboarding_skip"
        android:textColor="@color/cid_onb_muted"
        android:textSize="15sp" />

    <!-- ===== bottom stack · mid native above the CTA =====
         The ad sits ABOVE Continue, separated by a hairline, so the primary action stays
         the bottom-most control and is never the thing a thumb lands on by accident. The
         frame is full-bleed, so the horizontal inset lives on the button, not the footer.
         With ads off, showMidNative empties and hides the frame and followAdContainer
         drops the hairline, leaving the screen exactly as it was before. -->
    <LinearLayout
        android:id="@+id/onboarding_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical">

        <View
            android:id="@+id/ad_native_divider"
            style="@style/AdDivider" />

        <FrameLayout
            android:id="@+id/ad_native_frame"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/ad_shimmer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#ccc">

                <include layout="@layout/googlemidnative" />

            </com.facebook.shimmer.ShimmerFrameLayout>
        </FrameLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/onboarding_continue"
            style="@style/OnboardingButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="18dp"
            android:text="@string/onboarding_continue" />

    </LinearLayout>

    <!-- clip flags off all the way down, as on the set-as-default screen: the hero's slab
         bleeds past the 24dp gutter and the ghost handset is rotated, so anything that clips
         at the padding chops both of them off with a flat edge mid-screen. -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/onboarding_footer"
        android:layout_below="@id/onboarding_skip"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="24dp">

            <!-- hero · halo, soft slab, ghost handset, shield, verified badge -->
            <RelativeLayout
                android:id="@+id/onboarding_hero"
                android:layout_width="match_parent"
                android:layout_height="206dp"
                android:clipChildren="false"
                android:clipToPadding="false">

                <View
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentTop="true"
                    android:layout_marginEnd="-26dp"
                    android:background="@drawable/bg_onb_blob_square" />

                <View
                    android:id="@+id/onboarding_halo"
                    android:layout_width="186dp"
                    android:layout_height="186dp"
                    android:layout_centerHorizontal="true"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_onb_blob" />

                <ImageView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_alignParentStart="true"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="86dp"
                    android:alpha="0.45"
                    android:contentDescription="@null"
                    android:rotation="-18"
                    android:src="@drawable/ph_phone"
                    android:tint="@color/cid_onb_card_stroke" />

                <ImageView
                    android:id="@+id/onboarding_shield"
                    android:layout_width="92dp"
                    android:layout_height="104dp"
                    android:layout_centerHorizontal="true"
                    android:layout_marginTop="54dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_cid_shield_phone" />

                <ImageView
                    android:id="@+id/onboarding_badge"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_alignEnd="@id/onboarding_shield"
                    android:layout_alignBottom="@id/onboarding_shield"
                    android:layout_marginEnd="-12dp"
                    android:layout_marginBottom="-4dp"
                    android:background="@drawable/bg_onb_check_badge"
                    android:contentDescription="@null"
                    android:padding="11dp"
                    android:src="@drawable/ic_cid_tick"
                    android:tint="@color/cid_onb_on_accent" />

            </RelativeLayout>

            <org.fossify.commons.views.MyTextView
                android:id="@+id/onboarding_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:letterSpacing="-0.02"
                android:text="@string/onb_welcome_title"
                android:textColor="@color/cid_onb_ink"
                android:textSize="34sp"
                android:textStyle="bold" />

            <org.fossify.commons.views.MyTextView
                android:id="@+id/onboarding_lead"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="10dp"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:lineSpacingMultiplier="1.35"
                android:text="@string/onb_welcome_lead"
                android:textColor="@color/cid_onb_muted"
                android:textSize="15sp" />

            <!-- three feature tiles -->
            <LinearLayout
                android:id="@+id/onboarding_features"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    style="@style/OnbFeatureTile"
                    android:layout_marginEnd="6dp">

                    <ImageView
                        style="@style/OnbFeatureIcon"
                        android:src="@drawable/ic_cid_id_card" />

                    <org.fossify.commons.views.MyTextView
                        style="@style/OnbFeatureLabel"
                        android:text="@string/onb_feature_caller_id" />

                    <View style="@style/OnbFeatureRule" />
                </LinearLayout>

                <LinearLayout
                    style="@style/OnbFeatureTile"
                    android:layout_marginHorizontal="6dp">

                    <ImageView
                        style="@style/OnbFeatureIcon"
                        android:src="@drawable/ph_shield_warning" />

                    <org.fossify.commons.views.MyTextView
                        style="@style/OnbFeatureLabel"
                        android:text="@string/onb_feature_spam" />

                    <View style="@style/OnbFeatureRule" />
                </LinearLayout>

                <LinearLayout
                    style="@style/OnbFeatureTile"
                    android:layout_marginStart="6dp">

                    <ImageView
                        style="@style/OnbFeatureIcon"
                        android:src="@drawable/ph_shield_check" />

                    <org.fossify.commons.views.MyTextView
                        style="@style/OnbFeatureLabel"
                        android:text="@string/onb_feature_secure" />

                    <View style="@style/OnbFeatureRule" />
                </LinearLayout>

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="24dp" />

        </LinearLayout>

    </ScrollView>

</RelativeLayout>
