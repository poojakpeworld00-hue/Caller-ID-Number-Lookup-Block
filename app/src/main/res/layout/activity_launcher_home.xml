<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_holder"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- sits below the grid the same way the reference app stacks it: the grid is transparent, so
         the banner shows through, and opening the drawer or a side panel covers it -->
    <include
        android:id="@+id/default_launcher_banner"
        layout="@layout/default_launcher_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true" />

    <include
        android:id="@+id/home_screen_grid"
        layout="@layout/home_screen_grid" />

    <include
        android:id="@+id/all_apps_fragment"
        layout="@layout/all_apps_fragment"
        android:visibility="gone" />

    <include
        android:id="@+id/widgets_fragment"
        layout="@layout/widgets_fragment"
        android:visibility="gone" />

    <include
        android:id="@+id/left_panel"
        layout="@layout/left_panel_fragment"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/swipe_hint"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#be000000"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/swipe_hint_chevrons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:alpha="0.3"
                android:src="@drawable/ic_chevron_right_vector"
                android:tint="@android:color/white" />

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:alpha="0.6"
                android:src="@drawable/ic_chevron_right_vector"
                android:tint="@android:color/white" />

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_chevron_right_vector"
                android:tint="@android:color/white" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/swipe_right_hint"
            android:textColor="@android:color/white"
            android:textSize="18sp" />
    </LinearLayout>

    <View
        android:id="@+id/home_screen_popup_menu_anchor"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />

</RelativeLayout>
