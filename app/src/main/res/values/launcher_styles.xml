<resources xmlns:tools="http://schemas.android.com/tools">
<!-- Home-screen launcher. Ported from the reference launcher; kept in its own file
     so it stays separable from the caller-ID app's own resources. -->


    <style name="LauncherBaseTheme" parent="AppTheme.Base" />

    <style name="LauncherTheme" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>

        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>

    <!-- Onboarding runs on the Claude Design CID03 palette. Unlike the drawer and the side
         panels it is not pinned to a fixed light look: the design ships a .theme-dark and the
         cid_* tokens carry it, so these screens follow the user's theme and the light system-bar
         icons are overridden in values-night. -->
    <style name="OnboardingTheme" parent="LauncherBaseTheme">
        <item name="android:windowBackground">@drawable/bg_onboarding_screen</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
    </style>

    <!-- MaterialButton ignores android:background, and backgroundTint cannot carry a ripple, so
         the CTA is a plain AppCompat button with the design's g-700 pill as its background -->
    <style name="OnboardingButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:background">@drawable/bg_onboarding_cta</item>
        <item name="android:textColor">@color/cid_onb_on_cta</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:paddingTop">17dp</item>
        <item name="android:paddingBottom">17dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- The three feature tiles on the Welcome screen. Equal thirds of the row, so the
         width is 0dp and the weight carries it. -->
    <style name="OnbFeatureTile">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:background">@drawable/bg_onb_feature_card</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:paddingHorizontal">6dp</item>
    </style>

    <style name="OnbFeatureIcon">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:background">@drawable/bg_onb_feature_icon</item>
        <item name="android:padding">11dp</item>
        <item name="android:contentDescription">@null</item>
        <item name="android:tint">@color/cid_onb_ink</item>
    </style>

    <style name="OnbFeatureLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:gravity">center</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
        <item name="android:textColor">@color/cid_onb_ink</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="OnbFeatureRule">
        <item name="android:layout_width">22dp</item>
        <item name="android:layout_height">3dp</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:background">@drawable/bg_onb_feature_rule</item>
    </style>

    <!-- Mock incoming-call screen inside the Set-as-default illustration. -->
    <style name="OnbMockLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/cid_onb_on_mock</item>
    </style>

</resources>
