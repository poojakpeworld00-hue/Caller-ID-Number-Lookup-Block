<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="RecentFilterTab">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">@dimen/_7sdp</item>
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:fontFamily">@font/nunito_semibold</item>
        <item name="android:paddingHorizontal">@dimen/_11sdp</item>
        <item name="android:paddingVertical">@dimen/_5sdp</item>
        <item name="android:textColor">@color/csl_filter_tab</item>
        <item name="android:textSize">@dimen/_10ssp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:drawablePadding">@dimen/_3sdp</item>
    </style>

    <!-- Dial-pad key cell (digit + letters), one per GridLayout column. -->
    <style name="DialKey">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">@dimen/_44sdp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_gravity">fill_horizontal</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="DialKeyDigit">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/nunito_bold</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:textSize">@dimen/_20ssp</item>
    </style>

    <style name="DialKeyLetters">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/nunito_bold</item>
        <item name="android:letterSpacing">0.13</item>
        <item name="android:textColor">@color/on_surface_variant</item>
        <item name="android:textSize">@dimen/_7ssp</item>
    </style>

    <!-- Call Details action button (circle icon + label) -->
    <style name="DetailAction">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingVertical">@dimen/_4sdp</item>
    </style>

    <style name="DetailActionIcon">
        <item name="android:layout_width">@dimen/_40sdp</item>
        <item name="android:layout_height">@dimen/_40sdp</item>
        <item name="android:background">@drawable/bg_oval</item>
        <item name="android:padding">@dimen/_10sdp</item>
    </style>

    <style name="DetailActionLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/_6sdp</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textSize">@dimen/_10ssp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Flashlight mode button -->
    <style name="FlashMode">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/bg_card_border</item>
        <item name="android:backgroundTint">@color/surface</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingVertical">@dimen/_12sdp</item>
    </style>

    <style name="FlashModeIcon">
        <item name="android:layout_width">@dimen/_22sdp</item>
        <item name="android:layout_height">@dimen/_22sdp</item>
        <item name="android:tint">@color/on_surface_variant</item>
    </style>

    <style name="FlashModeLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/_5sdp</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:textSize">@dimen/_10ssp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Timer preset chip (+1:00 etc.) -->
    <style name="TimerPreset">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/bg_card_border</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingVertical">@dimen/_12sdp</item>
    </style>

    <style name="TimerPresetValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:textSize">@dimen/_14ssp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TimerPresetLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/_2sdp</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/on_surface_variant</item>
        <item name="android:textSize">@dimen/_8ssp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Speed-test metric card (Upload / Latency / Jitter) -->
    <style name="SpeedStatCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/_10sdp</item>
        <item name="android:background">@drawable/bg_card_border</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">@dimen/_14sdp</item>
    </style>

    <style name="SpeedStatLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/on_surface_variant</item>
        <item name="android:textSize">@dimen/_9ssp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="SpeedStatValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/_3sdp</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:textSize">@dimen/_16ssp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="SpeedStatBar">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/_8sdp</item>
        <item name="trackColor">@color/surface_2</item>
        <item name="indicatorColor">@color/primary</item>
        <item name="trackThickness">@dimen/_5sdp</item>
        <item name="trackCornerRadius">@dimen/_4sdp</item>
    </style>

    <!-- SIM info detail tile (card cell) -->
    <style name="SimTile">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/bg_card_border</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">@dimen/_14sdp</item>
    </style>

    <!-- Battery Activity stat column -->
    <style name="BatteryStat">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="BatteryStatLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/on_surface_variant</item>
        <item name="android:textSize">@dimen/_9ssp</item>
    </style>

    <style name="BatteryStatValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/_3sdp</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:textSize">@dimen/_14ssp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Blocklist FAB · rounded-square (18dp) instead of a full circle. -->
    <style name="ShapeAppearance.Fab.Rounded" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/_18sdp</item>
    </style>

    <!-- Smooth scale+fade for custom (non-system) dialogs. -->
    <style name="DialogScaleAnimation">
        <item name="android:windowEnterAnimation">@anim/dialog_scale_in</item>
        <item name="android:windowExitAnimation">@anim/dialog_scale_out</item>
    </style>

    <!-- Spring-up / slide-down for bottom-sheet-style dialogs. -->
    <style name="SheetSlideAnimation">
        <item name="android:windowEnterAnimation">@anim/sheet_slide_up</item>
        <item name="android:windowExitAnimation">@anim/sheet_slide_down</item>
    </style>

    <!-- Tools category header (in-grid, spans both columns). -->
    <style name="ToolsCategory">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/_12sdp</item>
        <item name="android:layout_marginBottom">@dimen/_2sdp</item>
        <item name="android:fontFamily">@font/nunito_extrabold</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:textSize">@dimen/_9ssp</item>
    </style>

    <!-- Uppercase section label on the Settings screen -->
    <style name="SettingsSection">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/_10sdp</item>
        <item name="android:layout_marginBottom">@dimen/_8sdp</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/on_surface_variant</item>
        <item name="android:textSize">@dimen/_9ssp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!--
        1dp full-bleed hairline that separates app content from an ad container.
        Edge-to-edge by design: no margins, so it spans the whole screen width.
    -->
    <style name="AdDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/ad_divider</item>
    </style>

</resources>
