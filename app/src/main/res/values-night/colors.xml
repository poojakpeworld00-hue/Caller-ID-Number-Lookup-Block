<?xml version="1.0" encoding="utf-8"?>
<!--
    Dark-theme overrides. Only the SEMANTIC tokens are redefined here; every
    layout/drawable references these names, so the whole app flips light<->dark
    automatically. Brand/literal colors (primary, on_primary, accent, danger,
    warn, white, black) are intentionally NOT overridden — they stay defined
    once in values/colors.xml and apply to both themes.
-->
<resources>
    <!-- Surfaces & background — Visual System v1 true-dark ramp (OLED) -->
    <color name="background">#0B0E14</color>
    <color name="surface">#141824</color>
    <color name="surface_2">#1C2231</color>
    <color name="card_bg_light">#141824</color>

    <!-- Soft elevation shadow on dark surfaces -->
    <color name="card_shadow">#59000000</color>

    <!-- Text / icons on surfaces -->
    <color name="on_surface">#F2F4FA</color>
    <color name="on_surface_variant">#8A93A8</color>

    <!-- Lines & containers -->
    <color name="outline">#2A3145</color>
    <color name="ad_divider">#26FFFFFF</color>       <!-- hairline between app content and ads -->
    <color name="primary_container">#1C2231</color>
    <color name="on_primary_container">#9DB4FF</color>

    <!-- Language screen: unselected radio ring (dark) -->
    <color name="radio_unselected">#5D6579</color>

    <!-- Verdict containers (dark) -->
    <color name="identified_container">#143126</color>
    <color name="identified_on">#7BD8A8</color>
    <color name="spam_container">#2A1518</color>
    <color name="spam_on">#F09A9A</color>
    <color name="spam_avatar_bg">#47232A</color>

    <!-- Lookup -->
    <color name="success">#7FD98A</color>

    <!-- Splash redesign dark overrides. Per Visual System, the hero gradient stays
         a rich Sapphire→Violet even in dark (just deepened) — not near-black. -->
    <color name="splash_grad_start">#1E3A8F</color>
    <color name="splash_grad_center">#3B34C4</color>
    <color name="splash_grad_end">#4A2AC0</color>
    <color name="splash_card_bg">#141824</color>
    <color name="splash_card_name">#F2F4FA</color>
    <color name="splash_card_sub">#8A93A8</color>
    <color name="splash_chip_bg">#1C2231</color>
    <color name="splash_chip_fg">#8A93A8</color>
    <color name="splash_verdict_container">#143126</color>
    <color name="splash_verdict_on">#7BD8A8</color>
    <!-- Phone illustration (dark navy) -->
    <color name="splash_phone_bg">#171F36</color>
    <color name="splash_phone_stroke">#2E3A5C</color>
    <color name="splash_content_line">#243050</color>
    <color name="splash_notch">#2A3352</color>

    <!-- FSI intro Activity — dark (navy) variant of the design. -->
    <color name="fsi_bg_center">#16233F</color>
    <color name="fsi_bg_edge">#0F172A</color>
    <color name="fsi_title">#FFFFFF</color>
    <color name="fsi_subtitle">#99FFFFFF</color>
    <color name="fsi_benefit_card">#14FFFFFF</color>
    <color name="fsi_benefit_border">#1AFFFFFF</color>
    <color name="fsi_benefit_text">#D9FFFFFF</color>
    <color name="fsi_benefit_divider">#12FFFFFF</color>
    <color name="fsi_not_now">#80FFFFFF</color>
    <color name="fsi_orbit_ring">#5A60A5FA</color>
    <color name="fsi_glow">#472563EB</color>
    <color name="fsi_tile_blue">#2E2563EB</color>
    <color name="fsi_tile_red">#29EF4444</color>
    <color name="fsi_tile_green">#2922C55E</color>
    <color name="fsi_icon_blue">#60A5FA</color>
    <color name="fsi_icon_red">#F87171</color>
    <color name="fsi_icon_green">#4ADE80</color>

    <!-- Enable-Caller-ID dialog — dark variants. -->
    <color name="cid_hint_bg">#242563EB</color>         <!-- ~0.14 blue tint on dark -->
    <color name="cid_shield_check">#0B0E14</color>      <!-- dark checkmark on light-blue shield -->
    <color name="cid_toggle_off">#3A4256</color>
</resources>
