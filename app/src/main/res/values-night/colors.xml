<?xml version="1.0" encoding="utf-8"?>
<!--
    Dark-theme overrides. Only the SEMANTIC tokens are redefined here; every
    layout/drawable references these names, so the whole app flips light<->dark
    automatically. Brand/literal colors (primary, on_primary, accent, danger,
    warn, white, black) are intentionally NOT overridden — they stay defined
    once in values/colors.xml and apply to both themes.

    Surface/text tokens below delegate to colors_cid.xml's own night variants
    (values-night/colors_cid.xml) via @color reference, so they track the
    Claude Design's dark-mode g-ramp inversion automatically.
-->
<resources>
    <!-- Surfaces & background — Claude Design (CID03) dark ramp -->
    <color name="background">@color/cid_bg</color>
    <color name="surface">@color/cid_neutral_100</color>
    <color name="surface_2">@color/cid_g_100</color>
    <color name="card_bg_light">#131C1A</color>

    <!-- Soft elevation shadow on dark surfaces (brand-agnostic, unchanged) -->
    <color name="card_shadow">#59000000</color>

    <!-- Text / icons on surfaces -->
    <color name="on_surface">@color/cid_g_900</color>
    <color name="on_surface_variant">@color/cid_neutral_700</color>

    <!-- Lines & containers -->
    <color name="outline">@color/cid_neutral_300</color>
    <color name="ad_divider">#26FFFFFF</color>       <!-- hairline between app content and ads -->
    <color name="primary_container">@color/cid_g_100</color>
    <color name="on_primary_container">@color/cid_g_800</color>

    <!-- Language screen: unselected radio ring (dark) -->
    <color name="radio_unselected">@color/cid_neutral_400</color>

    <!-- Verdict containers (dark) -->
    <color name="identified_container">#143126</color>
    <color name="identified_on">#7BD8A8</color>
    <color name="spam_container">#2A1518</color>
    <color name="spam_on">#F09A9A</color>
    <color name="spam_avatar_bg">#47232A</color>

    <!-- Lookup -->
    <color name="success">#7FD98A</color>

    <!-- Splash redesign dark overrides. Per Visual System, the hero gradient stays
         a rich Sapphire→Violet even in dark (just deepened) — not near-black. -->
    <color name="splash_grad_start">#04532B</color>
    <color name="splash_grad_center">#0B7A31</color>
    <color name="splash_grad_end">#1E9E3B</color>
    <color name="splash_card_bg">#131C15</color>
    <color name="splash_card_name">#F0F5F1</color>
    <color name="splash_card_sub">#869C8B</color>
    <color name="splash_chip_bg">#1B261E</color>
    <color name="splash_chip_fg">#869C8B</color>
    <color name="splash_verdict_container">#143126</color>
    <color name="splash_verdict_on">#7BD8A8</color>
    <!-- Phone illustration (dark) -->
    <color name="splash_phone_bg">#162118</color>
    <color name="splash_phone_stroke">#2C3F32</color>
    <color name="splash_content_line">#223329</color>
    <color name="splash_notch">#28372D</color>

    <!-- FSI intro Activity — dark (navy) variant of the design. -->
    <color name="fsi_bg_center">#14332E</color>
    <color name="fsi_bg_edge">#0E1A18</color>
    <color name="fsi_title">#FFFFFF</color>
    <color name="fsi_subtitle">#99FFFFFF</color>
    <color name="fsi_benefit_card">#14FFFFFF</color>
    <color name="fsi_benefit_border">#1AFFFFFF</color>
    <color name="fsi_benefit_text">#D9FFFFFF</color>
    <color name="fsi_benefit_divider">#12FFFFFF</color>
    <color name="fsi_not_now">#80FFFFFF</color>
    <color name="fsi_orbit_ring">#5A4DBFB2</color>
    <color name="fsi_glow">#4700897B</color>
    <color name="fsi_tile_blue">#2E00897B</color>
    <color name="fsi_tile_red">#29EF4444</color>
    <color name="fsi_tile_green">#2922C55E</color>
    <color name="fsi_icon_blue">#4DBFB2</color>
    <color name="fsi_icon_red">#F87171</color>
    <color name="fsi_icon_green">#4ADE80</color>

    <!-- Enable-Caller-ID dialog — dark variants. -->
    <color name="cid_hint_bg">#2400897B</color>         <!-- ~0.14 blue tint on dark -->
    <color name="cid_shield_check">#0A0F0E</color>      <!-- dark checkmark on light-blue shield -->
    <color name="cid_toggle_off">#3A4256</color>

    <!-- ===== Semantic colours that need a dark-ground counterpart =====
         Everything else in values/colors.xml is deliberately theme-independent:
           · black / white and the *_soft alpha tints are literals;
           · bg and text_secondary are aliases onto background / on_surface_variant,
             which already flip here, so they inherit correctly;
           · splash_* is fixed brand artwork — the splash looks the same in both themes;
           · all_app_*, panel_* and semitransparent_navigation belong to the launcher,
             which runs Theme.Material3.Dark over the wallpaper and is always dark;
           · fsi_*, online_green and whatsapp_green are brand marks.
         The ones below are the surface/semantic colours that genuinely lose contrast
         when the ground inverts, so they are lightened here. -->
    <color name="primary">#7FBB98</color>
    <color name="primary_dark">#5E9E7A</color>
    <color name="on_primary">#08150D</color>
    <color name="accent">#4FC08A</color>
    <color name="danger">#FF6B6B</color>
    <color name="warn">#FFB13D</color>
    <color name="accent_purple">#A98BFF</color>

    <!-- 12%% tints: on a dark ground the light versions vanish, so they are mixed
         against dark rather than against white -->
    <color name="success_soft">#334FC08A</color>
    <color name="danger_soft">#33FF6B6B</color>
    <color name="neutral_soft">#338C97AB</color>
    <color name="accent_purple_soft">#33A98BFF</color>
</resources>
