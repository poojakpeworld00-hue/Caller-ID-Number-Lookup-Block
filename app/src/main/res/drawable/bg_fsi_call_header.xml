<?xml version="1.0" encoding="utf-8"?>
<!-- Blue header bar of the incoming-call preview card: top corners rounded to
     match the card, bottom flat so it sits flush against the card body. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/primary" />
    <corners
        android:topLeftRadius="@dimen/_18sdp"
        android:topRightRadius="@dimen/_18sdp"
        android:bottomLeftRadius="0dp"
        android:bottomRightRadius="0dp" />
</shape>
