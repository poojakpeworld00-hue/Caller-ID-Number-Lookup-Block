<?xml version="1.0" encoding="utf-8"?>
<!--
    Animated shield: the checkmark "draws" itself in (trimPathEnd 0→1) once, when
    the dialog opens. Started from code via AnimatedVectorDrawableCompat.
-->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:drawable="@drawable/ic_cid_shield">

    <target android:name="check">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="trimPathEnd"
                android:valueFrom="0"
                android:valueTo="1"
                android:duration="360"
                android:startOffset="240"
                android:interpolator="@android:interpolator/decelerate_quint" />
        </aapt:attr>
    </target>
</animated-vector>
