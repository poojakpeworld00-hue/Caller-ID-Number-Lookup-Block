<?xml version="1.0" encoding="utf-8"?>
<!-- Home hero panel: a deep-blue diagonal base with a soft light glow toward the
     top-right, and a smoothly rounded bottom edge that the search bar overlaps. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Base brand gradient -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#26A69A"
                android:endColor="#00695C" />
            <corners
                android:bottomLeftRadius="@dimen/_28sdp"
                android:bottomRightRadius="@dimen/_28sdp" />
        </shape>
    </item>

    <!-- Soft radial highlight, top-right -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.85"
                android:centerY="0.12"
                android:gradientRadius="75%p"
                android:startColor="#40FFFFFF"
                android:endColor="#00FFFFFF" />
            <corners
                android:bottomLeftRadius="@dimen/_28sdp"
                android:bottomRightRadius="@dimen/_28sdp" />
        </shape>
    </item>
</layer-list>
