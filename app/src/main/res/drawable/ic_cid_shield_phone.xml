<?xml version="1.0" encoding="utf-8"?>
<!--
    The onboarding hero mark: a solid shield with a handset and two signal arcs
    knocked out of it. Drawn as one filled shield plus white glyph paths, so the
    shield colour is set on the shield path and the glyph always reads as the
    paper behind it.

    The handset is the standard 24dp receiver silhouette, placed by a <group>
    transform rather than by hand-editing coordinates — the previous glyph was a
    hand-traced path whose start and end points did not meet, so the implicit
    close drew a spike out of the top-left corner of the receiver.

    Layout inside the 92x104 viewport: receiver centred at (38,58) at 1.6x, arcs
    struck from (54,50) at r=9 and r=14 so they radiate off the earpiece without
    touching it, and the whole group sits clear of the verified badge that the
    screens overlap on the shield's bottom-right corner.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="92dp"
    android:height="104dp"
    android:viewportWidth="92"
    android:viewportHeight="104">

    <!-- shield body -->
    <path
        android:fillColor="@color/cid_onb_mark"
        android:pathData="M46,2 L84,17 C86.2,17.9 87.6,20 87.6,22.4 L87.6,52 C87.6,77.9 70.6,94.6 48.6,101.6 C47,102.1 45,102.1 43.4,101.6 C21.4,94.6 4.4,77.9 4.4,52 L4.4,22.4 C4.4,20 5.8,17.9 8,17 Z" />

    <!-- handset · 24dp receiver, scaled 1.6x and centred at (38,58) -->
    <group
        android:scaleX="1.6"
        android:scaleY="1.6"
        android:translateX="18.8"
        android:translateY="38.8">
        <path
            android:fillColor="@color/cid_onb_on_mark"
            android:pathData="M6.62,10.79 c1.44,2.83 3.76,5.14 6.59,6.59 l2.2,-2.2 c0.27,-0.27 0.67,-0.36 1.02,-0.24 c1.12,0.37 2.33,0.57 3.57,0.57 c0.55,0 1,0.45 1,1 V20 c0,0.55 -0.45,1 -1,1 c-9.39,0 -17,-7.61 -17,-17 c0,-0.55 0.45,-1 1,-1 h3.5 c0.55,0 1,0.45 1,1 c0,1.25 0.2,2.45 0.57,3.57 c0.11,0.35 0.03,0.74 -0.25,1.02 Z" />
    </group>

    <!-- signal arcs · stroked so both waves keep an even weight and round ends -->
    <path
        android:pathData="M56.3,41.3 A9,9 0 0 1 63,50.8"
        android:strokeColor="@color/cid_onb_on_mark"
        android:strokeWidth="3"
        android:strokeLineCap="round" />
    <path
        android:pathData="M57.6,36.5 A14,14 0 0 1 67.9,51.2"
        android:strokeColor="@color/cid_onb_on_mark"
        android:strokeWidth="3"
        android:strokeLineCap="round" />

</vector>
