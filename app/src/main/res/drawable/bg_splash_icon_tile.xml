<?xml version="1.0" encoding="utf-8"?>
<!-- Rounded app-icon tile (white → soft lilac) at the centre of the splash. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:startColor="@color/splash_icon_tile_top"
        android:endColor="@color/splash_icon_tile_bottom"
        android:type="linear" />
    <corners android:radius="@dimen/_24sdp" />
</shape>
