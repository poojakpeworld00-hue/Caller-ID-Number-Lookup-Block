<?xml version="1.0" encoding="utf-8"?>
<!-- Soft ambient orb — radial fade approximates a blurred glow. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <gradient
        android:type="radial"
        android:gradientRadius="50%"
        android:startColor="@color/splash_orb"
        android:endColor="@color/splash_orb_edge" />
</shape>
