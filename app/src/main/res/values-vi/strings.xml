    <!-- Terms &amp; Conditions -->
    <string name="terms_title">Điều khoản và Điều kiện</string>
    <string name="terms_body">Vui lòng đọc kỹ các điều khoản sau. Khi tiếp tục, bạn đồng ý với những điều sau:\n\n• CallerID nhận diện cuộc gọi đến, gọi đi và số lạ theo thời gian thực.\n• Ứng dụng phát hiện và giúp bạn chặn cuộc gọi spam, lừa đảo và gian lận.\n• Bạn có thể tra cứu bất kỳ số điện thoại nào để xem thông tin người gọi hiện có.\n• Để hoạt động đúng cách, ứng dụng có thể truy cập nhật ký cuộc gọi và danh bạ của bạn.\n• Quyền hiển thị trên ứng dụng khác (lớp phủ) được dùng để hiển thị thông tin người gọi trong khi gọi.\n• Dữ liệu của bạn luôn được giữ riêng tư và chỉ dùng để cung cấp nhận diện người gọi và bảo vệ khỏi spam.\n\nKhi nhấn “Chấp nhận và tiếp tục”, bạn xác nhận đã đọc và đồng ý với Điều khoản và Điều kiện cùng Chính sách quyền riêng tư của chúng tôi.</string>
    <string name="terms_agree">Tôi đã đọc và đồng ý với Điều khoản và Điều kiện cùng Chính sách quyền riêng tư.</string>
    <string name="terms_accept">Chấp nhận và tiếp tục</string>
    <string name="terms_please_accept">Vui lòng chấp nhận Điều khoản và Điều kiện để tiếp tục.</string>
