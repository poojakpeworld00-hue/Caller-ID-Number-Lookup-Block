    <!-- Terms &amp; Conditions -->
    <string name="terms_title">नियम और शर्तें</string>
    <string name="terms_body">कृपया इन शर्तों को ध्यान से पढ़ें। जारी रखकर, आप निम्नलिखित से सहमत होते हैं:\n\n• CallerID आने वाली, जाने वाली और अनजान कॉल की रीयल-टाइम में पहचान करता है।\n• ऐप स्पैम, घोटाले और धोखाधड़ी वाली कॉल का पता लगाता है और उन्हें ब्लॉक करने में मदद करता है।\n• आप किसी भी फ़ोन नंबर को खोजकर उपलब्ध कॉलर विवरण देख सकते हैं।\n• सही ढंग से काम करने के लिए, ऐप आपके कॉल लॉग और संपर्कों तक पहुँच सकता है।\n• कॉल के दौरान कॉलर जानकारी दिखाने के लिए अन्य ऐप्स के ऊपर दिखाने (ओवरले) की अनुमति का उपयोग किया जाता है।\n• आपका डेटा निजी रहता है और इसका उपयोग केवल कॉलर पहचान और स्पैम सुरक्षा के लिए किया जाता है।\n\n“स्वीकार करें और जारी रखें” पर टैप करके आप पुष्टि करते हैं कि आपने हमारी नियम और शर्तें तथा गोपनीयता नीति पढ़ी है और उनसे सहमत हैं।</string>
    <string name="terms_agree">मैंने नियम और शर्तें तथा गोपनीयता नीति पढ़ी है और उनसे सहमत हूँ।</string>
    <string name="terms_accept">स्वीकार करें और जारी रखें</string>
    <string name="terms_please_accept">जारी रखने के लिए कृपया नियम और शर्तें स्वीकार करें।</string>
    <string name="txt_allow_overlay_access">अन्य ऐप्स के ऊपर दिखाने की अनुमति दें</string>
    <string name="overlay_system_permission">सिस्टम अनुमति</string>
    <string name="overlay_permission_desc">अन्य ऐप्स के ऊपर दिखाने की अनुमति इस ऐप को अन्य ऐप्स का उपयोग करते समय कॉलर जानकारी दिखाने देती है।</string>

