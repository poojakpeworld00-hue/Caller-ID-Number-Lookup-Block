<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT"/>
    <!-- CallerOverlayService runs as a foregroundServiceType="specialUse" FGS during a ring. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- ── Home-screen launcher ─────────────────────────────────────────────────────
         The home screen hosts app widgets and the icon menu offers uninstall.
         (Launcher-activity enumeration comes from the <queries> block below.) -->
    <uses-permission
        android:name="android.permission.BIND_APPWIDGET"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />

    <!-- Package visibility (Android 11+) for the apps/intents we hand off to. -->
    <queries>
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />

        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="text/plain" />
        </intent>
    </queries>

    <queries>
        <intent>
            <action android:name="android.telecom.action.CHANGE_PHONE_ACCOUNTS" />
        </intent>
    </queries>

    <!-- Package visibility for the launcher: without this, queryIntentActivities for
         MAIN/LAUNCHER returns almost nothing on API 30+ and the app drawer comes up empty. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Widget picker: AppWidgetManager.installedProviders + shortcut-style widgets. -->
        <intent>
            <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.CREATE_SHORTCUT" />
        </intent>
    </queries>

    <application
        android:name=".LookupShellApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_label"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.CallerLookupBlock">

        <activity
            android:screenOrientation="portrait"
            android:name=".ui.splash.LaunchActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:screenOrientation="portrait"
            android:name=".ui.language.LocaleActivity"
            android:exported="false" />

        <activity
            android:screenOrientation="portrait"
            android:name=".ui.terms.ConsentActivity"
            android:exported="false" />

        <activity
            android:screenOrientation="portrait"
            android:name=".ui.terms.FloatAccessActivity"
            android:exported="false"
            android:theme="@style/Theme.OverlayGuide" />

        <activity
            android:screenOrientation="portrait"
            android:name=".ui.onboarding.IntroActivity"
            android:exported="false" />

        <activity
            android:screenOrientation="portrait"
            android:name=".ui.ShellActivity"
            android:exported="false" />

        <!-- ══ Home-screen launcher ═══════════════════════════════════════════════
             LauncherHomeActivity is the actual home screen: it carries the HOME
             intent-filter, so it is what the system shows once the user makes this
             app their default launcher. The onboarding screens ahead of it run once,
             right after the caller-ID splash. -->
        <!--
             excludeFromRecents only governs recents when the activity is the ROOT of its
             task, and these two are not — the caller-ID splash roots the task and starts
             them into it (dumpsys: rootOfTask=false). It is declared anyway so the flow
             still behaves if it is ever entered directly, but the attribute that actually
             does the work is the runtime AppTask.setExcludeFromRecents() call in
             SimpleActivity.excludeAppFromRecents(), invoked by both screens.
        -->
        <activity
            android:name=".launcher.activities.OnboardingWelcomeActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/OnboardingTheme" />

        <activity
            android:name=".launcher.activities.OnboardingDefaultLauncherActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/OnboardingTheme" />

        <activity
            android:name=".launcher.activities.MainActivity"
            android:clearTaskOnLaunch="true"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:theme="@style/LauncherTheme">

            <intent-filter>
                <action android:name="android.content.pm.action.CONFIRM_PIN_SHORTCUT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".launcher.activities.SettingsActivity"
            android:configChanges="orientation"
            android:exported="false"
            android:label="@string/launcher_settings"
            android:parentActivityName=".launcher.activities.MainActivity"
            android:theme="@style/LauncherBaseTheme" />

        <activity
            android:name=".launcher.activities.HiddenIconsActivity"
            android:exported="false"
            android:label="@string/hidden_icons"
            android:parentActivityName=".launcher.activities.SettingsActivity"
            android:theme="@style/LauncherBaseTheme" />

        <activity
            android:name="org.fossify.commons.activities.CustomizationActivity"
            android:exported="false"
            android:label="@string/customize_colors"
            android:parentActivityName=".launcher.activities.SettingsActivity"
            android:theme="@style/LauncherBaseTheme" />

        <!-- The long-press "lock screen" action needs a device-admin component to call
             lockNow() through. -->
        <receiver
            android:name=".launcher.receivers.LockDeviceAdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin_policies" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".launcher.widgets.DigitalClockWidgetProvider"
            android:exported="false"
            android:label="@string/digital_clock_widget">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/digital_clock_widget_info" />
        </receiver>

        <receiver
            android:name=".launcher.widgets.AnalogClockWidgetProvider"
            android:exported="false"
            android:label="@string/analog_clock_widget">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/analog_clock_widget_info" />
        </receiver>

        <!-- Firebase-gated Full-Screen-Intent priming Screen (after Language). -->
        <activity
            android:screenOrientation="portrait"
            android:name=".permission.fsi.FullScreenAccessActivity"
            android:exported="false" />

        <!-- Auto-return watcher: pulls the app back when the FSI toggle flips on. -->
        <service
            android:name=".permission.fsi.FullScreenWatchService"
            android:exported="false" />

        <activity
            android:screenOrientation="portrait"
            android:name=".ui.blocklist.BlockRosterActivity"
            android:exported="false" />

        <activity
            android:screenOrientation="portrait"
            android:name=".ui.settings.PreferencesActivity"
            android:exported="false" />

        <activity
            android:screenOrientation="portrait"
            android:name=".ui.lookup.TerritoryPickerActivity"
            android:exported="false" />

        <activity
            android:screenOrientation="portrait"
            android:name=".ui.lookup.IdentifyInsightActivity"
            android:exported="false" />

        <activity
            android:screenOrientation="portrait"
            android:name=".ui.lookup.IdentifyTraceActivity"
            android:exported="false" />

        <!-- The keypad is the only input on this screen: never let the system
             keyboard open (stateAlwaysHidden) and never resize the dialpad for
             it (adjustNothing). -->
        <activity
            android:screenOrientation="portrait"
            android:name=".ui.dialer.KeypadActivity"
            android:windowSoftInputMode="stateAlwaysHidden|adjustNothing"
            android:exported="false" />

        <activity
            android:screenOrientation="portrait"
            android:name=".ui.detail.CallInsightActivity"
            android:exported="false" />

        <activity
            android:screenOrientation="portrait"
            android:name=".ui.tools.UtilityActivity"
            android:exported="false" />

        <activity
            android:screenOrientation="portrait"
            android:name=".ui.tools.BearingActivity"
            android:exported="false" />

        <activity
            android:screenOrientation="portrait"
            android:name=".ui.tools.VelocityActivity"
            android:exported="false" />

        <activity
            android:screenOrientation="portrait"
            android:name=".ui.tools.TorchActivity"
            android:exported="false" />

        <activity
            android:screenOrientation="portrait"
            android:name=".ui.tools.TiltActivity"
            android:exported="false" />

        <activity
            android:screenOrientation="portrait"
            android:name=".ui.tools.PowerGaugeActivity"
            android:exported="false" />

        <activity
            android:screenOrientation="portrait"
            android:name=".ui.tools.DecibelActivity"
            android:exported="false" />

        <activity
            android:screenOrientation="portrait"
            android:name=".ui.tools.SimCardActivity"
            android:exported="false" />

        <activity
            android:screenOrientation="portrait"
            android:name=".ui.tools.LuxMeterActivity"
            android:exported="false" />

        <activity
            android:screenOrientation="portrait"
            android:name=".ui.tools.ChronoActivity"
            android:exported="false" />

        <activity
            android:screenOrientation="portrait"
            android:name=".ui.tools.CountdownActivity"
            android:exported="false" />

        <!-- Caller-ID card shown over the keyguard when a call rings while the device is locked.

             taskAffinity="" for the same reason as My_Shell_Screen below: started from a
             Service with NEW_TASK, it would otherwise resolve into this package's home task
             once the app is the default launcher, and never appear. -->
        <activity
            android:name=".ui.incall.InboundCallActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:showWhenLocked="true"
            android:taskAffinity=""
            android:theme="@style/Theme.OverlayGuide"
            android:turnScreenOn="true" />

        <!-- Post-call (callback) screen shown after a call ends. Lives in the
             admesh package, so it needs a fully-qualified name (the
             manifest's default namespace is ...contacts.calllog). -->

        <!-- Fires on every phone-state change to drive the caller-ID card -->
        <receiver
            android:name=".services.onincomming.CallStateReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PHONE_STATE" />
            </intent-filter>
        </receiver>

        <!-- Floating caller-ID overlay (device unlocked) -->
        <service
            android:name=".services.onincomming.IdentFloatService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="caller_id" />
        </service>

        <!-- Screens incoming calls to reject blocked numbers before they ring
             (requires the user to grant the CallScreening role on Android 10+). -->
        <service
            android:name=".services.onincomming.ScreenerService"
            android:exported="true"
            android:permission="android.permission.BIND_SCREENING_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.CallScreeningService" />
            </intent-filter>
        </service>

        <!-- Polls for the overlay permission during the Terms flow -->
        <service
            android:name=".ui.terms.FloatWatchService"
            android:exported="false" />

        <!-- Persists the per-app language chosen via AppCompatDelegate.setApplicationLocales -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>


        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713" />
        <activity
            android:screenOrientation="portrait"
            android:name="com.calleridapp.admesh.presentation.ADDashboardActivity"
            android:exported="false" />

        <!--
             taskAffinity="" is what makes this screen appear at all once the app is the default
             launcher. Without it the activity inherits the package's default affinity, and
             `singleInstance` resolves its task *by affinity* — the only task with that affinity
             is then the launcher's own home task (`Task{... type=home A=<package>}`), which the
             framework will not let host a non-home activity. The start fails, every caller
             swallows the exception, and the notification fallback only fires on a locked or
             sleeping screen — so after a call on an awake phone, nothing showed.

             An empty affinity means "no affinity": always a fresh standalone task, never merged
             into home. Paired with excludeFromRecents it behaves as the transient popup it is.
        -->
        <activity
            android:name="com.calleridapp.admesh.presentation.my_main_counter.My_Shell_Screen"
            android:launchMode="singleInstance"
            android:turnScreenOn="true"
            android:excludeFromRecents="true"
            android:exported="true"
            android:screenOrientation="portrait"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustResize" />

        <!-- Post-call + caller-ID handling is consolidated into the single
             .services.onincomming.CallReceiver (registered above). -->

        <service
            android:name="com.calleridapp.admesh.presentation.my_main_counter.service.ShelllJobService"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.BIND_JOB_SERVICE">
            <intent-filter>
                <action android:name="com.firebase.jobdispatcher.ACTION_EXECUTE" />
            </intent-filter>
        </service>

        <receiver
            android:name="com.calleridapp.admesh.presentation.my_main_counter.receiver.StartupReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
