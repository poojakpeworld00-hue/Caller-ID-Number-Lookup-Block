<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT"/>
    <!-- CallerOverlayService runs as a foregroundServiceType="specialUse" FGS during a ring. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- ── Home-screen launcher ─────────────────────────────────────────────────────
         The :launcher module's manifest brings BIND_APPWIDGET, EXPAND_STATUS_BAR and the
         <queries> it needs; the icon menu's uninstall is the one the app still declares. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <!-- androidx.core declares this signature permission AND a matching <uses-permission>; it is
         how ContextCompat.registerReceiver() implements RECEIVER_NOT_EXPORTED on API 26-32 (it
         registers with the permission instead of the flag, which only exists on API 33+).
         org.fossify:commons strips that <uses-permission> with tools:node="remove", leaving the
         permission declared but never requested — so checkSelfPermission() denies and every
         NOT_EXPORTED registration throws "Permission ... is required by your application to
         receive broadcasts" on pre-33 devices (crashed MainActivity via PseudoClockWidget).
         Re-declaring it here restores it; tools:node="replace" beats the library's removal. -->
    <uses-permission
        android:name="${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        tools:node="replace" />

    <!-- Package visibility (Android 11+) for the apps/intents we hand off to. -->
    <queries>
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />

        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="text/plain" />
        </intent>
    </queries>

    <queries>
        <intent>
            <action android:name="android.telecom.action.CHANGE_PHONE_ACCOUNTS" />
        </intent>
    </queries>

    <application
        android:name=".LookupShellApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_label"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.CallerLookupBlock">

        <!-- WorkManager off the eager androidx.startup path, initialised on first use instead.
             WorkManagerInitializer runs inside InitializationProvider, i.e. before the app has a
             single line of its own running, and anything it throws is an un-catchable startup
             fatal: `NoSuchMethodError: No virtual method JobScheduler.forNamespace` on ROMs that
             report API 34 without shipping the API 34 method WorkManager calls behind that very
             version check. On demand, the same failure lands inside a reminder call this app can
             guard, and costs a reminder instead of the whole app. LookupShellApp supplies the
             configuration WorkManager would otherwise have taken from the initializer. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                tools:node="remove" />
        </provider>

        <!-- Post-crash relaunch helper. Its own process, because the crashing one is stalled
             inside the Crashlytics handler and cannot host an Activity any more; its own task
             (taskAffinity="") so it never lands in the home task when we hold the HOME role. -->
        <activity
            android:name=".util.CrashRestartActivity"
            android:process=":restart"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:screenOrientation="portrait"
            android:theme="@style/Theme.CallerLookupBlock" />

        <activity
            android:screenOrientation="portrait"
            android:name=".ui.splash.LaunchActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:screenOrientation="portrait"
            android:name=".ui.language.LocaleActivity"
            android:exported="false" />

        <activity
            android:screenOrientation="portrait"
            android:name=".ui.terms.ConsentActivity"
            android:exported="false" />

        <activity
            android:screenOrientation="portrait"
            android:name=".ui.terms.FloatAccessActivity"
            android:exported="false"
            android:theme="@style/Theme.OverlayGuide" />

        <!-- Redesigned overlay-permission coach-mark (the sheet-style card). Same transparent
             host as FloatAccessActivity above, which it is meant to replace. -->
        <activity
            android:screenOrientation="portrait"
            android:name="com.calleridapp.admesh.presentation.OverlayGuideActivity"
            android:exported="false"
            android:theme="@style/Theme.OverlayGuide" />

        <activity
            android:screenOrientation="portrait"
            android:name=".ui.onboarding.IntroActivity"
            android:exported="false" />

        <activity
            android:screenOrientation="portrait"
            android:name=".ui.ShellActivity"
            android:exported="false" />

        <!-- ══ Launcher onboarding ═══════════════════════════════════════════════
             The home screen itself (LauncherPanel, with the HOME intent-filter), its settings
             screens, widgets and device-admin receiver all come from the :launcher module's
             own manifest. The onboarding screens ahead of it run once, right after the
             caller-ID splash. -->
        <!--
             excludeFromRecents only governs recents when the activity is the ROOT of its
             task, and these two are not — the caller-ID splash roots the task and starts
             them into it (dumpsys: rootOfTask=false). It is declared anyway so the flow
             still behaves if it is ever entered directly, but the attribute that actually
             does the work is the runtime AppTask.setExcludeFromRecents() call in
             LauncherFlow's excludeAppFromRecents(), invoked by both screens.
        -->
        <activity
            android:name=".onboard.OnboardingWelcomeActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/OnboardingTheme" />

        <!-- The centred, dimmed "pick this app" hint over the system Default home app list.
             Translucent and in its own task (empty affinity), so it sits over Settings instead
             of joining this app's task behind it. -->
        <activity
            android:name=".onboard.RoleHintActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:screenOrientation="portrait"
            android:taskAffinity=""
            android:theme="@style/Theme.OverlayGuide" />

        <activity
            android:name=".onboard.OnboardingDefaultLauncherActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/OnboardingTheme" />

        <!-- ══ Ad-flow screens (ported from the reference app) ═════════════════════ -->

        <!-- The in-app page a direct link opens in when `link_open_in` / `DirectLinkType` is webview. -->
        <activity
            android:name="com.calleridapp.admesh.presentation.PromoWebActivity"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@style/Theme.PromoWeb" />

        <!-- Reopened from Recents: `recent_ad` in `launcher_ads` decides whether this ever shows. -->
        <activity
            android:name=".ui.recent.RecentAdActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTop"
            android:screenOrientation="portrait" />

        <!--
            The install / uninstall result screen. singleTask so a second package event arriving
            while it is up is delivered to onNewIntent instead of stacking another copy.
        -->
        <activity
            android:name=".ui.pkgresult.PackageResultActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:taskAffinity="" />

        <!-- The optimisation screen the package result links to. -->
        <activity
            android:name=".ui.cleaner.CleanerActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- The charge / discharge screen. Shown by ChargeEventWatcher from one of our own screens;
             its own task so it overlays cleanly and stays out of the back stack. Shows over the
             lock screen. -->
        <activity
            android:name=".ui.charging.ChargingStatusActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:showWhenLocked="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Charging"
            android:turnScreenOn="true" />

        <!-- Firebase-gated Full-Screen-Intent priming Screen (after Language). -->
        <activity
            android:screenOrientation="portrait"
            android:name=".permission.fsi.FullScreenAccessActivity"
            android:exported="false" />

        <!-- Auto-return watcher: pulls the app back when the FSI toggle flips on. -->
        <service
            android:name=".permission.fsi.FullScreenWatchService"
            android:exported="false" />

        <activity
            android:screenOrientation="portrait"
            android:name=".ui.blocklist.BlockRosterActivity"
            android:exported="false" />

        <activity
            android:screenOrientation="portrait"
            android:name=".ui.settings.PreferencesActivity"
            android:exported="false" />

        <activity
            android:screenOrientation="portrait"
            android:name=".ui.lookup.TerritoryPickerActivity"
            android:exported="false" />

        <activity
            android:screenOrientation="portrait"
            android:name=".ui.lookup.IdentifyInsightActivity"
            android:exported="false" />

        <activity
            android:screenOrientation="portrait"
            android:name=".ui.lookup.IdentifyTraceActivity"
            android:exported="false" />

        <!-- The keypad is the only input on this screen: never let the system
             keyboard open (stateAlwaysHidden) and never resize the dialpad for
             it (adjustNothing). -->
        <activity
            android:screenOrientation="portrait"
            android:name=".ui.dialer.KeypadActivity"
            android:windowSoftInputMode="stateAlwaysHidden|adjustNothing"
            android:exported="false" />

        <activity
            android:screenOrientation="portrait"
            android:name=".ui.detail.CallInsightActivity"
            android:exported="false" />

        <activity
            android:screenOrientation="portrait"
            android:name=".ui.tools.UtilityActivity"
            android:exported="false" />

        <activity
            android:screenOrientation="portrait"
            android:name=".ui.tools.BearingActivity"
            android:exported="false" />

        <activity
            android:screenOrientation="portrait"
            android:name=".ui.tools.VelocityActivity"
            android:exported="false" />

        <activity
            android:screenOrientation="portrait"
            android:name=".ui.tools.TorchActivity"
            android:exported="false" />

        <activity
            android:screenOrientation="portrait"
            android:name=".ui.tools.TiltActivity"
            android:exported="false" />

        <activity
            android:screenOrientation="portrait"
            android:name=".ui.tools.PowerGaugeActivity"
            android:exported="false" />

        <activity
            android:screenOrientation="portrait"
            android:name=".ui.tools.DecibelActivity"
            android:exported="false" />

        <activity
            android:screenOrientation="portrait"
            android:name=".ui.tools.SimCardActivity"
            android:exported="false" />

        <activity
            android:screenOrientation="portrait"
            android:name=".ui.tools.LuxMeterActivity"
            android:exported="false" />

        <activity
            android:screenOrientation="portrait"
            android:name=".ui.tools.ChronoActivity"
            android:exported="false" />

        <activity
            android:screenOrientation="portrait"
            android:name=".ui.tools.CountdownActivity"
            android:exported="false" />

        <!-- Caller-ID card shown over the keyguard when a call rings while the device is locked.

             taskAffinity="" for the same reason as My_Shell_Screen below: started from a
             Service with NEW_TASK, it would otherwise resolve into this package's home task
             once the app is the default launcher, and never appear. -->
        <activity
            android:name=".ui.incall.InboundCallActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:showWhenLocked="true"
            android:taskAffinity=""
            android:theme="@style/Theme.OverlayGuide"
            android:turnScreenOn="true" />

        <!-- Post-call (callback) screen shown after a call ends. Lives in the
             admesh package, so it needs a fully-qualified name (the
             manifest's default namespace is ...contacts.calllog). -->

        <!-- Fires on every phone-state change to drive the caller-ID card -->
        <receiver
            android:name=".services.onincomming.CallStateReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PHONE_STATE" />
            </intent-filter>
        </receiver>

        <!-- Floating caller-ID overlay (device unlocked) -->
        <service
            android:name=".services.onincomming.IdentFloatService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="caller_id" />
        </service>

        <!-- Screens incoming calls to reject blocked numbers before they ring
             (requires the user to grant the CallScreening role on Android 10+). -->
        <service
            android:name=".services.onincomming.ScreenerService"
            android:exported="true"
            android:permission="android.permission.BIND_SCREENING_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.CallScreeningService" />
            </intent-filter>
        </service>

        <!-- Polls for the overlay permission during the Terms flow -->
        <service
            android:name=".ui.terms.FloatWatchService"
            android:exported="false" />

        <!-- Persists the per-app language chosen via AppCompatDelegate.setApplicationLocales -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>


        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713" />
        <!-- Turns off the AdMob "native ad validator" popup that debug builds draw over test native
             ads. It is a WebView loaded from gstatic.com: it covered the permission sheet, and showed
             "Web page not available" whenever the first launch had no network yet. -->
        <meta-data
            android:name="com.google.android.gms.ads.flag.NATIVE_AD_DEBUGGER_ENABLED"
            android:value="false" />
        <!-- The SDKs' full-screen ad windows get an opaque black background (see Theme.AdWindow):
             with plain Theme.Translucent the screen underneath showed through the status bar strip. -->
        <activity
            android:name="com.google.android.gms.ads.AdActivity"
            android:theme="@style/Theme.AdWindow"
            tools:replace="android:theme" />
        <activity
            android:name="com.facebook.ads.AudienceNetworkActivity"
            android:theme="@style/Theme.AdWindow"
            tools:replace="android:theme" />
        <activity
            android:screenOrientation="portrait"
            android:name="com.calleridapp.admesh.presentation.ADDashboardActivity"
            android:exported="false" />

        <!--
             taskAffinity="" is what makes this screen appear at all once the app is the default
             launcher. Without it the activity inherits the package's default affinity, and
             `singleInstance` resolves its task *by affinity* — the only task with that affinity
             is then the launcher's own home task (`Task{... type=home A=<package>}`), which the
             framework will not let host a non-home activity. The start fails, every caller
             swallows the exception, and the notification fallback only fires on a locked or
             sleeping screen — so after a call on an awake phone, nothing showed.

             An empty affinity means "no affinity": always a fresh standalone task, never merged
             into home. Paired with excludeFromRecents it behaves as the transient popup it is.
        -->
        <activity
            android:name="com.calleridapp.admesh.presentation.my_main_counter.My_Shell_Screen"
            android:launchMode="singleInstance"
            android:turnScreenOn="true"
            android:excludeFromRecents="true"
            android:exported="true"
            android:screenOrientation="portrait"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustResize" />

        <!-- Post-call + caller-ID handling is consolidated into the single
             .services.onincomming.CallReceiver (registered above). -->

        <service
            android:name="com.calleridapp.admesh.presentation.my_main_counter.service.ShelllJobService"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.BIND_JOB_SERVICE">
            <intent-filter>
                <action android:name="com.firebase.jobdispatcher.ACTION_EXECUTE" />
            </intent-filter>
        </service>

        <receiver
            android:name="com.calleridapp.admesh.presentation.my_main_counter.receiver.StartupReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
