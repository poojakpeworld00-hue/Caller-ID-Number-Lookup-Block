<?xml version="1.0" encoding="utf-8"?>
<!--
    The band the drawer's apps dissolve into before they reach the search pill. Transparent where
    the grid is untouched, the drawer's own scrim colour where the pill sits, so a row scrolling
    past fades out instead of being cut against the bar. Flipped by DrawerSurface when the pill is
    at the top of the sheet instead of the bottom.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="270"
        android:centerColor="@color/launcher_drawer_fade_mid"
        android:endColor="@color/launcher_drawer_fade_end"
        android:startColor="@android:color/transparent"
        android:type="linear" />
</shape>
