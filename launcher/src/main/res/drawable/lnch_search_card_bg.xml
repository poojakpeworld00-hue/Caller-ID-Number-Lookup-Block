<?xml version="1.0" encoding="utf-8"?>
<!--
    A card of the drawer's search (suggested / searched apps, an app's shortcuts): a faint white
    over the drawer scrim with a hairline edge, so it groups its apps without washing them out.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/launcher_search_card_fill" />
    <stroke
        android:width="1dp"
        android:color="@color/launcher_search_card_edge" />
    <corners android:radius="24dp" />
</shape>
