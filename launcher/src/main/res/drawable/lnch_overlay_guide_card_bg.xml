<?xml version="1.0" encoding="utf-8"?>
<!-- The hint card's ground: light or dark from launcher_hint_colors (system mode), never the app theme. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/hint_card_bg" />
    <stroke
        android:width="1dp"
        android:color="@color/hint_card_stroke" />
    <corners android:radius="22dp" />
</shape>
