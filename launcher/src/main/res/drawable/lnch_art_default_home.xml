<?xml version="1.0" encoding="utf-8"?><!--
    Hero for the default-launcher card: a phone showing a home grid, with a chat bubble carrying
    a check mark popping off its corner - "make this the home screen, messages included".
    White / light-blue palette so it sits on the card's primary gradient.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="64"
    android:viewportHeight="64">

    <!-- phone shell shadow -->
    <path
        android:fillColor="#331D5CE8"
        android:pathData="M20,9 h26 a6,6 0 0 1 6,6 v40 a6,6 0 0 1 -6,6 h-26 a6,6 0 0 1 -6,-6 v-40 a6,6 0 0 1 6,-6 z" />

    <!-- phone shell -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M19,6 h26 a6,6 0 0 1 6,6 v40 a6,6 0 0 1 -6,6 h-26 a6,6 0 0 1 -6,-6 v-40 a6,6 0 0 1 6,-6 z" />

    <!-- screen -->
    <path
        android:fillColor="#DCEBFF"
        android:pathData="M18,12 h28 a2,2 0 0 1 2,2 v36 a2,2 0 0 1 -2,2 h-28 a2,2 0 0 1 -2,-2 v-36 a2,2 0 0 1 2,-2 z" />

    <!-- speaker -->
    <path
        android:fillColor="#C4DAFF"
        android:pathData="M27,8 h10 a1.2,1.2 0 0 1 0,2.4 h-10 a1.2,1.2 0 0 1 0,-2.4 z" />

    <!-- home grid: 2 x 2 app tiles -->
    <path
        android:fillColor="#2F86FF"
        android:pathData="M21,17 h7 a1.5,1.5 0 0 1 1.5,1.5 v7 a1.5,1.5 0 0 1 -1.5,1.5 h-7 a1.5,1.5 0 0 1 -1.5,-1.5 v-7 a1.5,1.5 0 0 1 1.5,-1.5 z" />
    <path
        android:fillColor="#5EA3FF"
        android:pathData="M32,17 h7 a1.5,1.5 0 0 1 1.5,1.5 v7 a1.5,1.5 0 0 1 -1.5,1.5 h-7 a1.5,1.5 0 0 1 -1.5,-1.5 v-7 a1.5,1.5 0 0 1 1.5,-1.5 z" />
    <path
        android:fillColor="#5EA3FF"
        android:pathData="M21,29 h7 a1.5,1.5 0 0 1 1.5,1.5 v7 a1.5,1.5 0 0 1 -1.5,1.5 h-7 a1.5,1.5 0 0 1 -1.5,-1.5 v-7 a1.5,1.5 0 0 1 1.5,-1.5 z" />
    <path
        android:fillColor="#2F86FF"
        android:pathData="M32,29 h7 a1.5,1.5 0 0 1 1.5,1.5 v7 a1.5,1.5 0 0 1 -1.5,1.5 h-7 a1.5,1.5 0 0 1 -1.5,-1.5 v-7 a1.5,1.5 0 0 1 1.5,-1.5 z" />

    <!-- dock -->
    <path
        android:fillColor="#9CC4FF"
        android:pathData="M22,44 h20 a2.5,2.5 0 0 1 0,5 h-20 a2.5,2.5 0 0 1 0,-5 z" />

    <!-- home bar -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M27,54.5 h10 a1,1 0 0 1 0,2 h-10 a1,1 0 0 1 0,-2 z" />

    <!-- chat bubble with tail -->
    <path
        android:fillColor="#1D5CE8"
        android:pathData="M40,1 h17 a6,6 0 0 1 6,6 v10 a6,6 0 0 1 -6,6 h-9 l-6,5 v-5 h-2 a6,6 0 0 1 -6,-6 v-10 a6,6 0 0 1 6,-6 z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M40,2.5 h17 a4.5,4.5 0 0 1 4.5,4.5 v10 a4.5,4.5 0 0 1 -4.5,4.5 h-9.6 l-4,3.4 v-3.4 h-3.4 a4.5,4.5 0 0 1 -4.5,-4.5 v-10 a4.5,4.5 0 0 1 4.5,-4.5 z" />

    <!-- check mark -->
    <path
        android:pathData="M43.5,12.5 L47.5,16.5 L54.5,8.5"
        android:strokeColor="#1D5CE8"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="2.6" />

    <!-- stars -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M8,42 l1.4,3.6 l3.6,1.4 l-3.6,1.4 l-1.4,3.6 l-1.4,-3.6 l-3.6,-1.4 l3.6,-1.4 z" />
    <path
        android:fillColor="#B3FFFFFF"
        android:pathData="M6,20 l0.9,2.1 l2.1,0.9 l-2.1,0.9 l-0.9,2.1 l-0.9,-2.1 l-2.1,-0.9 l2.1,-0.9 z" />
    <path
        android:fillColor="#99FFFFFF"
        android:pathData="M57,36 m-2,0 a2,2 0 1 0 4,0 a2,2 0 1 0 -4,0 z" />

</vector>
