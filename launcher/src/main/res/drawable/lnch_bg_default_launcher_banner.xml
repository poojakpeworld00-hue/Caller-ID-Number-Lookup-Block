<?xml version="1.0" encoding="utf-8"?><!--
    Default-launcher card: the app's primary gradient on a 20 dp rounded rectangle with a faint
    white hairline. Provides the outline the card clips its decoration to.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <gradient
        android:angle="315"
        android:endColor="@color/primary_gradient_end"
        android:startColor="@color/primary_gradient_start"
        android:type="linear" />

    <stroke
        android:width="1dp"
        android:color="#33FFFFFF" />

    <corners android:radius="20dp" />

</shape>
