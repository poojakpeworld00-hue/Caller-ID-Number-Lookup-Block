<?xml version="1.0" encoding="utf-8"?>
<!-- Ring of the mimic radio button. White here and tinted at runtime, so one drawable animates
     between the unselected and selected colours — see PermissionHintActivity. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="oval">
    <solid android:color="@android:color/transparent" />
    <stroke
        android:width="2dp"
        android:color="#FFFFFFFF" />
</shape>
