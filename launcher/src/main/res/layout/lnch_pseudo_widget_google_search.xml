<?xml version="1.0" encoding="utf-8"?>
<!--
    The Google search bar we draw when Google's own widget cannot be placed on this phone: the G,
    a hint, and the mic. Taps are wired in HomeScreenGrid.placeAppWidget (Google search, voice).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/launcher_google_bar_height"
    android:layout_gravity="center"
    android:layout_marginStart="@dimen/launcher_google_bar_side"
    android:layout_marginEnd="@dimen/launcher_google_bar_side"
    android:background="@drawable/lnch_google_search_bar_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/google_bar_logoUi"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:adjustViewBounds="true"
        android:importantForAccessibility="no"
        android:paddingStart="16dp"
        android:paddingTop="13dp"
        android:paddingEnd="12dp"
        android:paddingBottom="13dp"
        android:src="@drawable/lnch_ic_google_g" />

    <TextView
        android:id="@+id/google_bar_hintUi"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:maxLines="1"
        android:text="@string/search"
        android:textColor="@color/launcher_google_bar_hint"
        android:textSize="16sp" />

    <ImageView
        android:id="@+id/google_bar_micUi"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:adjustViewBounds="true"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/search"
        android:paddingStart="12dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp"
        android:src="@drawable/lnch_ic_google_mic" />

</LinearLayout>
