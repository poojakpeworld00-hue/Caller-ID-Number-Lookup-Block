<?xml version="1.0" encoding="utf-8"?>
<!-- One of the other rows in the default-home coach-mark's mock list: empty radio, blank icon, generic label. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:gravity="center_vertical"
    android:importantForAccessibility="no"
    android:orientation="horizontal"
    android:paddingStart="24dp"
    android:paddingEnd="16dp">

    <View
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:background="@drawable/lnch_hint_mock_ring" />

    <View
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="18dp"
        android:background="@drawable/lnch_hint_mock_icon" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:text="@string/launcher_hint_mock_row"
        android:textColor="@color/hint_mock_row_text"
        android:textSize="15sp" />

</LinearLayout>
